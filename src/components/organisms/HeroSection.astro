---
import Download from '@lucide/astro/icons/download';
import Button from '@/components/atoms/Button.astro';
import AvailabilityBadge from '@/components/molecules/AvailabilityBadge.astro';
import ProjectCarousel from '@/components/organisms/ProjectCarousel.astro';
import type { Locale } from '@/i18n/config';
import { getCvPath, getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';
import type { ProjectSummary } from '@/lib/projects';

type Props = {
  locale: Locale;
  projects: ProjectSummary[];
};

const { locale, projects } = Astro.props;
const dictionary = getDictionary(locale);
const home = dictionary.home;
---

<section data-hero class="container-page pt-20 pb-12" aria-labelledby="hero-title">
  <div class="grid items-center gap-x-6 gap-y-12 lg:grid-cols-12">
    <div class="flex flex-col gap-6 lg:col-span-5">
      <AvailabilityBadge href={getRoutePath('contact', locale)} label={home.availability} />
      <p class="m-0 font-mono text-sm font-medium text-sig-text" lang="fr">
        <span class="inline-block w-0 animate-type overflow-hidden align-bottom whitespace-nowrap motion-reduce:w-auto">{home.signature}</span>
      </p>
      <h1 id="hero-title" class="m-0 text-display font-bold text-ink">
        {
          home.titleWords.map((word, index) => (
            <>
              <span class="inline-block overflow-hidden pb-[0.06em] align-bottom">
                <span data-word class="inline-block">{word}</span>
              </span>
              {index < home.titleWords.length - 1 && ' '}
            </>
          ))
        }<span aria-hidden="true" class="animate-blink font-mono font-semibold text-sig">_</span>
      </h1>
      <!-- Pas d'animation sur ce paragraphe : c'est le plus grand élément visible au chargement (LCP) -->
      <p class="m-0 max-w-[40ch] text-xl leading-[1.55]">{home.intro}</p>
      <div data-reveal class="mt-2 flex flex-wrap gap-3">
        <Button href={getRoutePath('projects', locale)}>{home.ctaProjects}</Button>
        <Button href={getCvPath(locale)} variant="secondary" download>
          <Download aria-hidden="true" size={18} />
          {dictionary.common.cv}
        </Button>
      </div>
    </div>
    <div class="lg:col-span-7">
      <ProjectCarousel locale={locale} projects={projects} />
    </div>
  </div>
</section>

<script>
  import { playIntro } from '@/scripts/intro';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) playIntro(hero);
</script>
