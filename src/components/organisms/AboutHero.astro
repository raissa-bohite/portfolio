---
import { Image } from 'astro:assets';
import Download from '@lucide/astro/icons/download';
import MapPin from '@lucide/astro/icons/map-pin';
import portrait from '@/assets/portrait/portrait.jpg';
import Button from '@/components/atoms/Button.astro';
import Eyebrow from '@/components/atoms/Eyebrow.astro';
import type { Locale } from '@/i18n/config';
import { getCvPath, getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const page = dictionary.aboutPage;
---

<section data-scroll-group class="container-page pt-16 pb-24">
  <div class="grid items-center gap-x-6 gap-y-12 lg:grid-cols-12">
    <div class="flex flex-col gap-6 lg:col-span-7">
      <div data-scroll-item class="flex flex-col gap-3">
        <Eyebrow>{page.eyebrow}</Eyebrow>
        <h1 class="m-0 text-display font-bold text-ink">{page.title}</h1>
      </div>
      <p data-scroll-item class="m-0 max-w-[52ch] text-xl leading-[1.55]">{page.intro}</p>
      <div data-scroll-item class="flex flex-wrap gap-3">
        <Button href={getCvPath(locale)} download>
          <Download aria-hidden="true" size={18} />
          {dictionary.common.cv}
        </Button>
        <Button href={getRoutePath('contact', locale)} variant="secondary">{page.contactCta}</Button>
      </div>
    </div>
    <div class="flex justify-center lg:col-span-5">
      <div class="relative w-full max-w-[380px]">
        <div class="glass overflow-hidden p-3">
          <Image
            data-scroll-mask
            src={portrait}
            alt={dictionary.meta.portraitAlt}
            widths={[380, 760]}
            sizes="(min-width: 1024px) 380px, 90vw"
            loading="eager"
            fetchpriority="high"
            class="block aspect-4/5 w-full rounded-control object-cover object-[50%_20%]"
          />
        </div>
        <p data-scroll-pop class="glass absolute bottom-12 -left-3 m-0 flex items-center gap-2.5 bg-glass-strong! px-4 py-3 text-sm font-semibold text-ink sm:-left-7">
          <MapPin aria-hidden="true" size={18} class="text-sig-text" />
          {page.location}
        </p>
      </div>
    </div>
  </div>
</section>
