---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Mail from '@lucide/astro/icons/mail';
import { Image } from 'astro:assets';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import ContactForm from '@/components/organisms/ContactForm.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import { profile } from '@/lib/profile';
import portrait from '@/assets/portrait/portrait-cutout.png';

type Props = { locale: Locale };

const { locale } = Astro.props;
const contact = getDictionary(locale).home.contact;
const channels = [
  { label: 'LinkedIn', href: profile.linkedinUrl },
  { label: 'GitHub', href: profile.githubUrl }
];
---

<!-- Contact : la présentation et les coordonnées à gauche, le formulaire existant dans une carte à droite -->
<section id="contact" aria-labelledby="contact-title" class="container-page py-24">
  <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-12">
    <div class="relative flex flex-col gap-6 lg:col-span-5 lg:min-h-[560px]">
      <SectionIntro id="contact-title" eyebrow={contact.eyebrow} title={contact.title} intro={contact.text} />

      <ul class="m-0 flex list-none flex-col gap-3 p-0">
        <li>
          <a
            href={`mailto:${profile.email}`}
            class="group flex min-h-12 items-center gap-3 rounded-surface border border-line bg-bg p-3 pr-4 text-ink no-underline shadow-glass-sm transition-colors hover:border-action"
          >
            <span aria-hidden="true" class="flex size-10 flex-none items-center justify-center rounded-full bg-linear-to-br from-brand to-brand-deep text-white">
              <Mail size={18} />
            </span>
            <span class="min-w-0 font-semibold break-all">{profile.email}</span>
          </a>
        </li>
        <li class="flex flex-wrap gap-3">
          {
            channels.map((channel) => (
              <a
                href={channel.href}
                rel="me noopener"
                class="group inline-flex min-h-11 items-center gap-2 rounded-full border border-line bg-bg px-4 font-semibold text-ink no-underline shadow-glass-sm transition-colors hover:border-action hover:text-action"
              >
                {channel.label}
                <ArrowUpRight aria-hidden="true" size={16} class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </a>
            ))
          }
        </li>
      </ul>

      <!-- Petit portrait décoratif en bas de colonne, sur arche lavande, comme dans la maquette -->
      <div aria-hidden="true" class="pointer-events-none absolute right-0 bottom-0 hidden h-44 w-40 lg:block">
        <div class="absolute bottom-0 h-[86%] w-full rounded-t-full bg-tint"></div>
        <Image src={portrait} alt="" widths={[200, 400]} sizes="160px" loading="lazy" class="absolute bottom-0 h-full w-full object-contain object-bottom" />
      </div>
    </div>

    <!-- Le formulaire n'est pas modifié : même composant, même envoi, même protection -->
    <div class="relative rounded-block border border-line bg-bg p-5 shadow-glass sm:p-8 lg:col-span-7">
      <div aria-hidden="true" class="absolute -top-3 -right-3 hidden size-16 bg-[radial-gradient(circle,#b9a4f5_1.6px,transparent_1.8px)] bg-size-[16px_16px] sm:block"></div>
      <ContactForm locale={locale} variant="compact" class="relative" />
    </div>
  </div>
</section>
