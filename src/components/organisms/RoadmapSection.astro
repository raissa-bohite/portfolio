---
import Eyebrow from '@/components/atoms/Eyebrow.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const roadmap = getDictionary(locale).aboutPage.roadmap;
---

<section aria-labelledby="roadmap-title" class="container-page pb-24">
  <div class="flex flex-col gap-10">
    <div class="flex flex-col gap-1">
      <Eyebrow>{roadmap.eyebrow}</Eyebrow>
      <h2 id="roadmap-title" class="m-0 text-h2 font-bold text-ink">{roadmap.title}</h2>
      <p class="mt-2 mb-0 max-w-[60ch]">{roadmap.intro}</p>
    </div>
    <ol data-roadmap class="m-0 grid list-none grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4 p-0">
      {
        roadmap.steps.map((step, index) => (
          <li class="flex flex-col gap-3 rounded-surface border border-glass-border bg-bg p-6 shadow-glass">
            <span
              data-roadmap-step={index}
              data-reached={String(index === 0)}
              class="self-start rounded-full border-[1.5px] border-line px-3 py-1.5 text-sm font-semibold whitespace-nowrap text-text transition-colors duration-300 data-[reached=true]:border-sig data-[reached=true]:bg-sig data-[reached=true]:text-[#1E0F45]"
            >
              {step.stage}
            </span>
            <h3 class="m-0 text-subtitle font-bold text-ink">{step.title}</h3>
            <p class="m-0">{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { setupRoadmap } from '@/scripts/roadmap';

  const roadmap = document.querySelector<HTMLElement>('[data-roadmap]');
  if (roadmap) setupRoadmap(roadmap);
</script>
