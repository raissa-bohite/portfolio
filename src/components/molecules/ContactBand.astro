---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Button from '@/components/atoms/Button.astro';
import Eyebrow from '@/components/atoms/Eyebrow.astro';

type Props = { eyebrow: string; title: string; cta: string; href: string };
const { eyebrow, title, cta, href } = Astro.props;
---

<section aria-labelledby="contact-band-title" class="container-page pb-24">
  <div class="glass flex flex-wrap items-center justify-between gap-6 bg-glass-strong! p-8 md:px-12">
    <div class="flex flex-col gap-1">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 id="contact-band-title" class="m-0 text-[clamp(28px,3vw,36px)] leading-[1.15] font-bold text-ink">{title}</h2>
    </div>
    <Button href={href}>
      {cta}
      <ArrowRight aria-hidden="true" size={18} />
    </Button>
  </div>
</section>
