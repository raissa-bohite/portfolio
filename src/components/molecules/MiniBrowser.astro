---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = { image: ImageMetadata; sizes: string; class?: string; priority?: boolean };
const { image, sizes, class: className, priority = false } = Astro.props;
---

<!-- Petite fenêtre de navigateur décorative pour les vignettes de la galerie -->
<div aria-hidden="true" class:list={['overflow-hidden rounded-[12px] bg-white shadow-[0_24px_50px_-18px_rgb(0_0_0/0.5)]', className]}>
  <div class="flex gap-1 border-b border-[#ece6f6] px-2.5 py-1.5">
    <span class="size-1.5 rounded-full bg-[#ff5f57]"></span>
    <span class="size-1.5 rounded-full bg-[#febc2e]"></span>
    <span class="size-1.5 rounded-full bg-[#28c840]"></span>
  </div>
  <Image src={image} alt="" widths={[480, 900, 1400]} sizes={sizes} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} class="block h-auto w-full" />
</div>
