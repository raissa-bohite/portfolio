---
import CircleCheck from '@lucide/astro/icons/circle-check';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Mail from '@lucide/astro/icons/mail';
import Send from '@lucide/astro/icons/send';
import User from '@lucide/astro/icons/user';
import FormField from '@/components/molecules/FormField.astro';
import RequestTypeChoice from '@/components/molecules/RequestTypeChoice.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import { contactLimits, contactRequestTypes } from '@/lib/contact-schema';

type Props = {
  locale: Locale;
  // « compact » : liste déroulante ; « full » : page Contact, cartes de choix ;
  // « card » : accueil, champs empilés et cartes de choix dans une carte étroite
  variant?: 'compact' | 'full' | 'card';
  class?: string;
};

const { locale, variant = 'compact', class: className } = Astro.props;
const form = getDictionary(locale).contactForm;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
const isCard = variant === 'card';
const typeOptions = contactRequestTypes.map((value) => ({ value, label: form.types[value], hint: form.typeHints[value] }));
---

<div data-contact-form data-state="idle" class:list={['group/form', className]}>
  <form action="/api/contact" method="post" aria-label={form.label} class="flex flex-col gap-6 group-data-[state=success]/form:hidden">
    <input type="hidden" name="locale" value={locale} />
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label for={`${variant}-website`}>Website</label>
      <input id={`${variant}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    {
      isCard && (
        <div class="flex items-start gap-4">
          <span aria-hidden="true" class="flex size-[52px] flex-none items-center justify-center rounded-full bg-tint text-tint-ink">
            <Send size={22} />
          </span>
          <p class="m-0 pt-1 text-base text-text">{form.privacy}</p>
        </div>
      )
    }

    {
      variant === 'full' && (
        <fieldset class="m-0 flex flex-col gap-3 border-0 p-0">
          <legend class="mb-3 text-sm font-semibold text-ink">{form.typeLegend}</legend>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-3">
            {typeOptions.map((option, index) => (
              <RequestTypeChoice name="type" value={option.value} label={option.label} hint={option.hint} checked={index === 0} />
            ))}
          </div>
        </fieldset>
      )
    }

    <div class:list={['grid gap-4', !isCard && 'sm:grid-cols-2']}>
      <FormField id={`${variant}-name`} name="name" label={form.name} autocomplete="name" error={form.nameError} maxLength={contactLimits.nameMax}>
        {isCard && <User slot="icon" size={20} />}
      </FormField>
      <FormField
        id={`${variant}-email`}
        name="email"
        type="email"
        label={form.email}
        autocomplete="email"
        placeholder={form.emailPlaceholder}
        error={form.emailError}
        maxLength={contactLimits.emailMax}
      >
        {isCard && <Mail slot="icon" size={20} />}
      </FormField>
    </div>

    {
      isCard && (
        <fieldset class="m-0 flex flex-col gap-2 border-0 p-0">
          <legend class="mb-2 text-sm font-semibold text-ink">{form.typeLegend}</legend>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(120px,1fr))] gap-2.5">
            {typeOptions.map((option, index) => (
              <RequestTypeChoice name="type" value={option.value} label={option.label} hint={option.hint} checked={index === 0} />
            ))}
          </div>
        </fieldset>
      )
    }

    {
      variant === 'compact' && (
        <FormField
          id={`${variant}-type`}
          name="type"
          kind="select"
          label={form.type}
          error=""
          maxLength={20}
          options={typeOptions.map(({ value, label }) => ({ value, label }))}
        />
      )
    }
    <FormField
      id={`${variant}-message`}
      name="message"
      kind="textarea"
      rows={variant === 'full' ? 6 : 4}
      label={form.message}
      help={form.messageHelp}
      error={form.messageError}
      minLength={contactLimits.messageMin}
      maxLength={contactLimits.messageMax}
    />
    <!-- Rendu par turnstile.ts : version compacte quand la carte est plus étroite que le widget standard (300 px) -->
    {turnstileSiteKey && <div data-turnstile data-sitekey={turnstileSiteKey} data-language={locale} />}
    <p role="alert" class="m-0 hidden rounded-control border border-danger/40 bg-glass-strong p-4 text-sm font-medium text-ink group-data-[state=failure]/form:block">
      {form.failure}
    </p>
    <div class:list={['flex flex-wrap items-center justify-between gap-4', isCard && 'flex-col items-stretch']}>
      {!isCard && <p class="m-0 max-w-[44ch] text-sm text-muted">{form.privacy}</p>}
      <button
        type="submit"
        data-label-idle={form.submit}
        data-label-sending={form.sending}
        class:list={[
          'inline-flex min-h-12 w-full cursor-pointer items-center justify-center gap-2 whitespace-nowrap border-0 bg-action px-6 active:scale-[0.97] font-sans text-base font-semibold text-action-ink transition-colors hover:bg-action-hover disabled:cursor-wait disabled:opacity-70',
          isCard ? 'min-h-14 gap-3 rounded-full font-bold shadow-[0_12px_28px_rgb(74_35_160/0.28)]' : 'rounded-control sm:w-auto'
        ]}
      >
        {isCard && <Send aria-hidden="true" size={18} />}
        <span data-submit-label>{form.submit}</span>
        {isCard ? <ArrowRight aria-hidden="true" size={18} /> : <Send aria-hidden="true" size={18} />}
      </button>
    </div>
  </form>

  <div data-success tabindex="-1" role="status" class="hidden flex-col items-start gap-4 py-6 group-data-[state=success]/form:flex">
    <span aria-hidden="true" class="flex size-14 items-center justify-center rounded-control bg-tint text-tint-ink">
      <CircleCheck size={26} />
    </span>
    <h2 class="m-0 text-h2 font-bold text-ink">{form.successTitle}</h2>
    <p data-success-text data-template={form.successText} class="m-0 max-w-[48ch]"></p>
    <button
      type="button"
      data-action="again"
      class="min-h-12 cursor-pointer rounded-control border-[1.5px] border-action bg-glass-strong px-6 transition-transform duration-150 active:scale-[0.97] font-sans text-base font-semibold text-action"
    >
      {form.again}
    </button>
  </div>
</div>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" data-turnstile-api async defer />}

<script>
  import { setupContactForm } from '@/scripts/contact-form';
  import { renderTurnstileWidgets } from '@/scripts/turnstile';

  for (const container of document.querySelectorAll<HTMLElement>('[data-contact-form]')) setupContactForm(container);
  renderTurnstileWidgets();
</script>
