---
import { getCollection } from 'astro:content';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import TableOfContents from '@/components/molecules/TableOfContents.astro';
import BaseLayout from '@/components/templates/BaseLayout.astro';
import type { Locale } from '@/i18n/config';
import { getAlternateLinks, getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';
import { profile } from '@/lib/profile';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const [entry] = await getCollection('legal', (item) => item.data.locale === locale);
if (!entry) throw new Error(`Mentions légales manquantes pour la langue ${locale}`);
const legal = entry.data;
const alternates = getAlternateLinks((alternateLocale) => getRoutePath('legal', alternateLocale));
const updatedAt = new Intl.DateTimeFormat(locale, { dateStyle: 'long', timeZone: 'UTC' }).format(legal.updatedAt);
const tocItems = legal.sections.map((section) => ({ id: section.id, title: section.title }));
const EMAIL_TOKEN = '{email}';
// Typographie française : espace avant les deux-points
const labelSeparator = locale === 'fr' ? ' : ' : ': ';
const sectionNumber = (position: number): string => String(position).padStart(2, '0');
---

<BaseLayout locale={locale} title={legal.seoTitle} description={legal.seoDescription} currentRoute="legal" alternates={alternates}>
  <!-- Même en-tête que les autres pages : sur-titre à trait, titre à curseur, décor de cercles à droite -->
  <section aria-labelledby="legal-title" class="relative overflow-hidden">
    <span aria-hidden="true" class="absolute top-2 -right-16 hidden size-64 rounded-full bg-tint/80 md:block dark:bg-tint/50"></span>
    <span aria-hidden="true" class="absolute top-16 right-64 hidden size-4 rounded-full bg-sig md:block"></span>
    <div class="container-page relative flex flex-col items-start gap-5 pt-16 pb-12">
      <SectionIntro id="legal-title" eyebrow={legal.eyebrow} title={legal.title} highlight={false} cursor level="page" />
      <p class="m-0 rounded-full bg-tint px-4 py-1.5 text-sm font-semibold text-tint-ink">
        {legal.updatedLabel}{labelSeparator}<time datetime={legal.updatedAt.toISOString().slice(0, 10)}>{updatedAt}</time>
      </p>
    </div>
  </section>

  <div class="container-page pb-24">
    <div class="grid gap-6 lg:grid-cols-12">
      <TableOfContents title={dictionary.projectPage.tocTitle} label={dictionary.legalPage.tocLabel} items={tocItems} />
      <article class="flex flex-col rounded-block border border-glass-border bg-glass-strong px-6 py-4 shadow-glass sm:px-10 sm:py-6 lg:col-span-9">
        {
          legal.sections.map((section, index) => (
            <section
              id={section.id}
              data-toc-section
              aria-labelledby={`${section.id}-title`}
              class="grid scroll-mt-32 gap-4 border-dashed border-[#cdbff3] py-8 not-first:border-t sm:grid-cols-[4.5rem_minmax(0,1fr)] dark:border-white/15"
            >
              <!-- Numéro décoratif en contour, posé en pseudo-élément : ce n'est pas du texte à lire ni à contraster -->
              <span
                aria-hidden="true"
                data-number={sectionNumber(index + 1)}
                class="text-[2.75rem] leading-none font-extrabold tracking-[-0.04em] text-transparent [-webkit-text-stroke:1.5px_#b9a4f5] before:content-[attr(data-number)]"
              ></span>
              <div class="flex flex-col gap-4">
                <h2 id={`${section.id}-title`} class="m-0 text-title font-extrabold text-ink">
                  {section.title}
                </h2>
                {section.facts.length > 0 && (
                  <dl class="m-0 grid gap-x-6 gap-y-3 rounded-surface bg-tint/50 p-5 sm:grid-cols-[minmax(0,13rem)_1fr] dark:bg-white/[0.05]">
                    {section.facts.map((fact) => (
                      <>
                        <dt class="text-xs font-semibold tracking-[0.1em] text-action uppercase sm:pt-0.5">{fact.term}</dt>
                        <dd class="m-0 font-semibold text-ink">{fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}</dd>
                      </>
                    ))}
                  </dl>
                )}
                {section.paragraphs.map((paragraph) => {
                  // Le jeton {email} devient un vrai lien, sans jamais injecter de HTML depuis le contenu
                  const [before, after] = paragraph.split(EMAIL_TOKEN);
                  return (
                    <p class="m-0 max-w-[68ch]">
                      {before}
                      {after !== undefined && <a href={`mailto:${profile.email}`}>{profile.email}</a>}
                      {after}
                    </p>
                  );
                })}
              </div>
            </section>
          ))
        }
      </article>
    </div>
  </div>
</BaseLayout>
