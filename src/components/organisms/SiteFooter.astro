---
import type { Locale } from '@/i18n/config';
import { getCvPath, getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
---

<footer class="container-page relative pt-6 pb-10">
  <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6 text-sm text-muted">
    <p class="m-0">{dictionary.footer.copyright}</p>
    <nav aria-label={dictionary.footer.secondaryLabel}>
      <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-1 p-0">
        <li><a href={getCvPath(locale)} class="inline-flex min-h-11 items-center" download>{dictionary.footer.cv}</a></li>
        <li><a href={getRoutePath('legal', locale)} class="inline-flex min-h-11 items-center">{dictionary.footer.legal}</a></li>
      </ul>
    </nav>
  </div>
</footer>
