---
import type { ImageMetadata } from 'astro';
import BrowserFrame from '@/components/molecules/BrowserFrame.astro';

type Props = { label: string; image: ImageMetadata; alt: string; host: string; enlargeLabel: string };
const { label, image, alt, host, enlargeLabel } = Astro.props;
---

<section aria-label={label} class="container-page pb-24">
  <BrowserFrame image={image} alt={alt} host={host} enlargeLabel={enlargeLabel} sizes="(min-width: 1248px) 1152px, 92vw" priority />
</section>
