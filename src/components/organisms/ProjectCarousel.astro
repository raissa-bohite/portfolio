---
import { Image } from 'astro:assets';
import ChevronLeft from '@lucide/astro/icons/chevron-left';
import ChevronRight from '@lucide/astro/icons/chevron-right';
import Pause from '@lucide/astro/icons/pause';
import Play from '@lucide/astro/icons/play';
import IconButton from '@/components/atoms/IconButton.astro';
import type { Locale } from '@/i18n/config';
import { formatMessage, getDictionary } from '@/i18n/translate';
import type { ProjectSummary } from '@/lib/projects';

type Props = {
  locale: Locale;
  projects: ProjectSummary[];
};

const { locale, projects } = Astro.props;
const labels = getDictionary(locale).home.carousel;
---

<div
  data-carousel
  role="region"
  aria-roledescription={labels.roleDescription}
  aria-label={labels.label}
  data-label-pause={labels.pause}
  data-label-play={labels.play}
  data-label-position={labels.position}
  class="group/carousel relative h-[340px] touch-pan-y overflow-x-clip sm:h-[420px] lg:h-[460px] lg:overflow-x-visible"
>
  <div data-stage class="absolute inset-x-0 top-0 h-[250px] sm:h-[320px] lg:h-[360px]">
    {
      projects.map((project, index) => (
        <a
          href={project.href}
          data-card={index}
          aria-label={formatMessage(labels.cardLabel, { name: project.name, kind: project.kind })}
          tabindex={index === 0 ? 0 : -1}
          aria-hidden={index === 0 ? undefined : 'true'}
          class:list={[
            'absolute top-1/2 left-1/2 block w-[78%] max-w-[460px] sm:w-[68%] -translate-1/2 rounded-surface border border-glass-border bg-glass-strong p-3 shadow-[0_40px_80px_-40px_rgb(30_15_69/0.45)] backdrop-blur-[20px] will-change-transform',
            index > 0 && 'opacity-0 group-data-ready/carousel:opacity-100'
          ]}
        >
          <Image
            src={project.cover}
            alt=""
            widths={[480, 960]}
            sizes="(min-width: 1024px) 436px, 80vw"
            loading={index === 0 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            class="block aspect-16/10 w-full rounded-control bg-white object-cover object-top-left"
          />
        </a>
      ))
    }
  </div>

  <div class="absolute inset-x-0 bottom-2 flex sm:inset-x-6 flex-wrap items-end justify-between gap-4">
    {
      projects.map((project, index) => (
        <a href={project.href} data-caption hidden={index !== 0} class="flex flex-col no-underline">
          <span class="text-sm font-medium text-muted">{project.kind}</span>
          <span class="text-xl leading-snug font-bold text-ink">{project.name}</span>
        </a>
      ))
    }
    <div class="hidden items-center gap-0.5 rounded-2xl border border-glass-border bg-glass-strong p-1 group-data-ready/carousel:flex">
      <span data-counter aria-hidden="true" class="mr-2 ml-2.5 text-sm font-medium text-muted">1 / {projects.length}</span>
      <IconButton label={labels.previous} size="small" data-action="previous">
        <ChevronLeft aria-hidden="true" size={18} />
      </IconButton>
      <IconButton label={labels.pause} size="small" data-action="pause" data-paused="false" class="group/pause">
        <Pause aria-hidden="true" size={18} class="group-data-[paused=true]/pause:hidden" />
        <Play aria-hidden="true" size={18} class="hidden group-data-[paused=true]/pause:block" />
      </IconButton>
      <IconButton label={labels.next} size="small" data-action="next">
        <ChevronRight aria-hidden="true" size={18} />
      </IconButton>
    </div>
  </div>
  <p data-status aria-live="polite" class="sr-only"></p>
</div>

<script>
  import { setupCarousel } from '@/scripts/carousel';

  for (const carousel of document.querySelectorAll<HTMLElement>('[data-carousel]')) setupCarousel(carousel);
</script>
