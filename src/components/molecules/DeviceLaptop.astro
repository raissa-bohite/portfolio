---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  image: ImageMetadata;
  alt: string;
  loading?: 'lazy' | 'eager';
  class?: string;
};

const { image, alt, loading = 'lazy', class: className } = Astro.props;
---

<!-- Ordinateur portable dessiné en CSS : écran à bordure fine, caméra, socle aluminium avec encoche -->
<div class:list={['relative w-full', className]}>
  <div class="relative rounded-t-[18px] rounded-b-[6px] bg-[#16161B] p-[2.4%] pb-[3%] shadow-[0_40px_80px_-40px_rgb(30_15_69/0.5),inset_0_0_0_1.5px_rgb(255_255_255/0.08)]">
    <span aria-hidden="true" class="absolute top-[1%] left-1/2 size-1.5 -translate-x-1/2 rounded-full bg-[#2E2E36]"></span>
    <Image
      src={image}
      alt={alt}
      widths={[560, 1120]}
      sizes="(min-width: 1024px) 560px, 92vw"
      loading={loading}
      fetchpriority={loading === 'eager' ? 'high' : 'auto'}
      class="block aspect-16/10 w-full rounded-[4px] bg-white object-cover object-top-left"
    />
  </div>
  <div aria-hidden="true" class="relative -mx-[7%] h-3 rounded-b-[14px] bg-linear-to-b from-[#E4E1EC] to-[#A7A3B6] shadow-[0_18px_30px_-18px_rgb(30_15_69/0.6)] dark:from-[#55525F] dark:to-[#2E2C36]">
    <span class="absolute top-0 left-1/2 h-1 w-[16%] -translate-x-1/2 rounded-b-md bg-[#B9B5C6] dark:bg-[#24222B]"></span>
  </div>
</div>
