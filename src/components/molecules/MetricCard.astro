---
type Props = { value: string; label: string };
const { value, label } = Astro.props;
---

<div data-scroll-item class="glass flex flex-col gap-1 p-6">
  <p class="m-0 text-[clamp(32px,3.4vw,44px)] leading-none font-bold tracking-[-0.02em] text-ink">{value}</p>
  <p class="m-0 text-[15px] text-muted">{label}</p>
</div>
