---
import Eyebrow from '@/components/atoms/Eyebrow.astro';
import ContactAside from '@/components/organisms/ContactAside.astro';
import ContactForm from '@/components/organisms/ContactForm.astro';
import BaseLayout from '@/components/templates/BaseLayout.astro';
import type { Locale } from '@/i18n/config';
import { getAlternateLinks, getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const page = getDictionary(locale).contactPage;
const alternates = getAlternateLinks((alternateLocale) => getRoutePath('contact', alternateLocale));
---

<BaseLayout locale={locale} title={page.seoTitle} description={page.seoDescription} currentRoute="contact" alternates={alternates}>
  <section data-scroll-group class="container-page flex flex-col gap-4 pt-16 pb-12">
    <div data-scroll-item class="flex flex-col gap-3">
      <Eyebrow>{page.eyebrow}</Eyebrow>
      <h1 class="m-0 max-w-[18ch] text-display font-bold text-ink">{page.title}</h1>
    </div>
    <p data-scroll-item class="m-0 max-w-[52ch] text-xl leading-[1.55]">{page.intro}</p>
  </section>
  <section class="container-page pb-24">
    <div class="grid items-start gap-x-6 gap-y-8 lg:grid-cols-12">
      <div class="glass p-6 sm:p-10 lg:col-span-8">
        <ContactForm locale={locale} variant="full" class="relative" />
      </div>
      <ContactAside locale={locale} class="lg:col-span-4" />
    </div>
  </section>
</BaseLayout>
