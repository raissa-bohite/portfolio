---
import Mail from '@lucide/astro/icons/mail';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import ContactForm from '@/components/organisms/ContactForm.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import { profile } from '@/lib/profile';

type Props = { locale: Locale };

const { locale } = Astro.props;
const contact = getDictionary(locale).home.contact;
---

<section id="contact" aria-labelledby="contact-title" class="container-page py-24">
  <div class="glass grid gap-x-6 gap-y-10 bg-glass-strong! p-8 md:p-12 lg:grid-cols-12">
    <div class="flex flex-col gap-4 lg:col-span-5">
      <SectionHeading id="contact-title" eyebrow={contact.eyebrow} title={contact.title} />
      <p class="m-0">{contact.text}</p>
      <a href={`mailto:${profile.email}`} class="inline-flex min-h-12 items-center gap-2.5 self-start text-[17px] font-semibold">
        <Mail aria-hidden="true" size={18} />
        {profile.email}
      </a>
      <ul class="m-0 flex list-none gap-6 p-0 text-base font-semibold">
        <li><a href={profile.linkedinUrl} rel="me noopener" class="inline-flex min-h-11 items-center underline-offset-[5px]">LinkedIn</a></li>
        <li><a href={profile.githubUrl} rel="me noopener" class="inline-flex min-h-11 items-center underline-offset-[5px]">GitHub</a></li>
      </ul>
    </div>
    <ContactForm locale={locale} class="relative lg:col-span-7" />
  </div>
</section>
