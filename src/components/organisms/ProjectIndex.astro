---
import { Image } from 'astro:assets';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Tag from '@/components/atoms/Tag.astro';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';
import type { ProjectSummary } from '@/lib/projects';

type Props = {
  locale: Locale;
  projects: ProjectSummary[];
  // « teaser » sur l'accueil (avec titre de section), « full » sur la page Projets qui porte déjà son h1
  variant?: 'teaser' | 'full';
};

const { locale, projects, variant = 'teaser' } = Astro.props;
const dictionary = getDictionary(locale);
const RowHeading = variant === 'full' ? 'h2' : 'h3';
---

<section
  aria-labelledby={variant === 'teaser' ? 'projects-title' : undefined}
  aria-label={variant === 'full' ? dictionary.projectsPage.eyebrow : undefined}
  class:list={['container-page flex flex-col gap-12', variant === 'teaser' ? 'pt-16 pb-24' : 'pb-24']}
>
  {
    variant === 'teaser' && (
      <div class="flex flex-wrap items-end justify-between gap-4">
        <SectionHeading id="projects-title" eyebrow={dictionary.home.projects.eyebrow} title={dictionary.home.projects.title} />
        <a href={getRoutePath('projects', locale)} class="inline-flex min-h-12 items-center text-base font-semibold underline decoration-[1.5px] underline-offset-[5px]">
          {dictionary.common.allProjects}
        </a>
      </div>
    )
  }

  <div class="glass px-5 py-2 sm:px-8" data-project-index>
    {
      projects.map((project, index) => (
        <article data-row data-open={String(index === 0)} class="group border-t border-line first:border-t-0">
          <a href={project.href} class="grid grid-cols-[minmax(0,1fr)_48px] items-center gap-4 py-6 md:grid-cols-[minmax(0,1fr)_auto_48px] md:gap-6 md:py-7 text-ink no-underline hover:text-ink">
            <RowHeading class="m-0 text-[clamp(28px,3.4vw,44px)] leading-[1.1] font-bold tracking-[-0.02em] transition duration-400 ease-out-soft group-data-[open=true]:translate-x-2 group-data-[open=true]:text-action">
              {project.name}
            </RowHeading>
            <span class="col-start-1 row-start-2 -mt-3 text-sm font-medium text-muted md:col-start-2 md:row-start-1 md:mt-0">{project.kind}</span>
            <span
              aria-hidden="true"
              class="row-span-2 flex size-12 items-center justify-center rounded-control border border-line text-action transition duration-400 ease-out-soft group-data-[open=true]:border-transparent group-data-[open=true]:bg-action group-data-[open=true]:text-action-ink md:col-start-3 md:row-span-1 md:row-start-1"
            >
              <ArrowUpRight size={20} class="transition-transform duration-400 ease-out-soft group-data-[open=true]:rotate-45" />
            </span>
          </a>
          <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 ease-out-soft group-data-[open=true]:grid-rows-[1fr] hover-none:grid-rows-[1fr]">
            <div class="min-h-0 overflow-hidden">
              <div class="grid items-start gap-6 pb-8 md:grid-cols-12">
                <div class="flex flex-col gap-3 opacity-0 transition-opacity delay-150 duration-300 group-data-[open=true]:opacity-100 hover-none:opacity-100 md:col-span-5">
                  <p class="m-0 text-sm font-medium text-muted">{project.role}</p>
                  <p class="m-0">{project.description}</p>
                  <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
                    {project.stack.map((technology) => (
                      <li>
                        <Tag>{technology}</Tag>
                      </li>
                    ))}
                  </ul>
                  <a href={project.href} class="inline-flex min-h-12 items-center text-base font-semibold underline-offset-[5px]" tabindex="-1" aria-hidden="true">
                    {project.hasCaseStudy ? dictionary.common.caseStudy : dictionary.common.viewProject}
                  </a>
                </div>
                <Image
                  src={project.cover}
                  alt={project.coverAlt}
                  widths={[640, 1280]}
                  sizes="(min-width: 1024px) 640px, 90vw"
                  loading="lazy"
                  class="aspect-video w-full translate-y-6 scale-[.98] rounded-control bg-white object-cover object-top-left opacity-0 transition delay-100 duration-500 ease-out-soft group-data-[open=true]:translate-y-0 group-data-[open=true]:scale-100 group-data-[open=true]:opacity-100 hover-none:translate-y-0 hover-none:scale-100 hover-none:opacity-100 md:col-span-7"
                />
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<script>
  // Une seule ligne ouverte à la fois : celle survolée ou atteinte au clavier
  for (const index of document.querySelectorAll<HTMLElement>('[data-project-index]')) {
    const rows = Array.from(index.querySelectorAll<HTMLElement>('[data-row]'));
    for (const row of rows) {
      const open = (): void => {
        for (const otherRow of rows) otherRow.dataset['open'] = String(otherRow === row);
      };
      row.addEventListener('mouseenter', open);
      row.addEventListener('focusin', open);
    }
  }
</script>
