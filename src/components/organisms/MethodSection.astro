---
import { Image } from 'astro:assets';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import type { Locale } from '@/i18n/config';
import { formatMessage, getDictionary } from '@/i18n/translate';
import buildIllustration from '@/assets/method/build.png';
import designIllustration from '@/assets/method/design.png';
import understandIllustration from '@/assets/method/understand.png';
import verifyIllustration from '@/assets/method/verify.png';

type Props = { locale: Locale };

const { locale } = Astro.props;
const method = getDictionary(locale).home.method;
// Une illustration par étape, dans l'ordre comprendre, concevoir, construire, vérifier
const stepIllustrations = [understandIllustration, designIllustration, buildIllustration, verifyIllustration];
// Les pastilles passent du violet foncé à l'orange, comme le rail qui les relie
const badgeClasses = ['bg-brand-deeper text-white', 'bg-brand text-white', 'bg-[#7b4fe0] text-white', 'bg-sig text-[#1e0f45]'];
const lastIndex = method.steps.length - 1;
---

<!-- Fond plein (et non translucide) : l'anneau autour des pastilles reprend exactement sa couleur pour « couper » le rail -->
<section aria-labelledby="method-title" class="relative overflow-hidden bg-[#f4f0fd] dark:bg-[#1e1344]">
  <span aria-hidden="true" class="absolute -top-36 -right-28 size-80 rounded-full bg-[#e6ddfb] dark:bg-tint/60"></span>
  <span aria-hidden="true" class="absolute top-16 left-[46%] hidden size-4 rounded-full bg-sig md:block"></span>

  <div class="container-page relative flex flex-col gap-14 py-22">
    <div class="flex flex-wrap items-end justify-between gap-8">
      <SectionIntro id="method-title" eyebrow={method.eyebrow} title={method.title} highlight={false} cursor />
      <div class="flex max-w-[27rem] flex-col gap-2 border-l-[3px] border-brand pl-6">
        <p class="m-0 text-subtitle font-bold text-ink">{method.closing.title}</p>
        <p class="m-0 text-base text-text">{method.closing.text}</p>
      </div>
    </div>

    <ol data-scroll-group data-progress="x" data-progress-min-width="1024px" aria-label={method.listLabel} class="relative m-0 grid list-none gap-x-7 gap-y-12 p-0 sm:grid-cols-2 lg:grid-cols-4">
      <!--
        Rail de progression sur grand écran : un fond pâle, et par-dessus le dégradé violet → orange
        qui se remplit au défilement (scroll-progress.ts) ; sans animation, le dégradé est simplement plein
      -->
      <li data-progress-track aria-hidden="true" class="absolute top-[266px] right-[calc(25%-47px)] left-[26px] hidden h-[3px] rounded-full bg-[#ddd2f8] lg:block dark:bg-white/12"></li>
      <li data-progress-fill aria-hidden="true" class="absolute top-[266px] right-[calc(25%-47px)] left-[26px] hidden h-[3px] rounded-full bg-linear-to-r from-brand-deeper via-brand via-45% to-sig lg:block"></li>
      {
        method.steps.map((step, index) => (
          <li data-scroll-item class="group relative flex flex-col gap-[18px]">
            <div
              aria-hidden="true"
              class:list={[
                'flex h-[220px] items-center justify-center rounded-[28px] bg-linear-to-br from-white from-30% shadow-[0_18px_40px_rgb(74_35_160/0.10)] dark:from-white/[0.07]',
                index === lastIndex ? 'to-[#fde9dc] dark:to-[#3a1d2a]' : 'to-[#ece4fd] dark:to-white/[0.03]'
              ]}
            >
              <Image
                src={stepIllustrations[index] ?? understandIllustration}
                alt=""
                widths={[320, 640]}
                sizes="(min-width: 1024px) 250px, (min-width: 640px) 40vw, 80vw"
                loading="lazy"
                class="h-auto max-h-[82%] w-auto max-w-[86%] object-contain transition-transform duration-500 ease-out-soft group-hover:-translate-y-1.5"
              />
            </div>
            <span
              data-progress-step
              aria-hidden="true"
              class:list={[
                'relative mt-1 flex size-[52px] items-center justify-center rounded-full text-lg font-bold ring-[7px] ring-[#f4f0fd] dark:ring-[#1e1344]',
                badgeClasses[index]
              ]}
            >
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="m-0 mt-1 font-mono text-[1.5rem] font-semibold text-ink" lang="fr">
              <span class="sr-only">{formatMessage(method.step, { n: index + 1 })} : </span>{step.code}
            </h3>
            <p class="m-0 text-base text-text">{step.text}</p>
            <p
              class:list={[
                'm-0 mt-auto flex flex-col gap-1 border-t border-dashed pt-3.5',
                index === lastIndex ? 'border-[#f5b48a]' : 'border-[#cdbff3] dark:border-white/20'
              ]}
            >
              <span class:list={['text-xs font-bold tracking-[0.1em] uppercase', index === lastIndex ? 'text-sig-text' : 'text-action']}>
                {method.deliverableLabel}
              </span>
              <span class="text-base font-bold text-ink">{step.deliverable}</span>
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
