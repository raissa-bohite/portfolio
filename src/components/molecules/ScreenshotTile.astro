---
import Maximize from '@lucide/astro/icons/maximize-2';
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  image: ImageMetadata;
  alt: string;
  caption: string;
  enlargeLabel: string;
  accentClass: string;
  wide?: boolean;
};

const { image, alt, caption, enlargeLabel, accentClass, wide = false } = Astro.props;
// Version grand format servie seulement à l'ouverture de l'aperçu
const largeImage = await getImage({ src: image, width: 1920, format: 'webp' });
---

<!-- Capture façon « shot » : elle flotte sur la couleur du projet, coupée par le bord, et s'agrandit au clic -->
<figure data-scroll-item class:list={['group m-0 flex flex-col gap-3', wide && 'sm:col-span-2']}>
  <button
    type="button"
    data-lightbox-src={largeImage.src}
    data-lightbox-alt={alt}
    data-lightbox-caption={caption}
    aria-label={enlargeLabel}
    class:list={[
      'relative block w-full cursor-zoom-in overflow-hidden rounded-surface border-0 p-0',
      accentClass,
      wide ? 'aspect-[4/3] sm:aspect-[21/9]' : 'aspect-[4/3]'
    ]}
  >
    <span aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(120%_90%_at_0%_0%,rgb(255_255_255/0.22),transparent_60%)]"></span>
    <span
      class:list={[
        'absolute top-[12%] block overflow-hidden rounded-tl-[14px] bg-white text-left shadow-[0_30px_60px_-20px_rgb(0_0_0/0.45)] transition-transform duration-500 ease-out-soft group-hover:-translate-x-2 group-hover:-translate-y-2',
        wide ? 'left-[8%] w-[96%] sm:left-[14%] sm:w-[78%]' : 'left-[9%] w-[112%]'
      ]}
    >
      <span aria-hidden="true" class="flex gap-1.5 border-b border-[#ece6f6] px-3 py-2">
        <span class="size-2 rounded-full bg-[#ff5f57]"></span>
        <span class="size-2 rounded-full bg-[#febc2e]"></span>
        <span class="size-2 rounded-full bg-[#28c840]"></span>
      </span>
      <Image
        src={image}
        alt={alt}
        widths={[640, 1200, 1800]}
        sizes={wide ? '(min-width: 1248px) 900px, 90vw' : '(min-width: 1248px) 640px, (min-width: 640px) 50vw, 100vw'}
        loading="lazy"
        class="block h-auto w-full"
      />
    </span>
    <span
      aria-hidden="true"
      class="absolute right-4 bottom-4 z-10 flex size-10 items-center justify-center rounded-full bg-white text-[#1e0f45] opacity-0 shadow-lg transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
    >
      <Maximize size={18} />
    </span>
  </button>
  <figcaption class="text-[15px] font-semibold text-ink">{caption}</figcaption>
</figure>
