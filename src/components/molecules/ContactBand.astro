---
import ArrowRight from '@lucide/astro/icons/arrow-right';

type Props = { eyebrow: string; title: string; cta: string; href: string };
const { eyebrow, title, cta, href } = Astro.props;
---

<!-- Fin de page : le bloc violet du contact de l'accueil, en version courte. Couleurs fixes, contraste supérieur à 7:1 -->
<section aria-labelledby="contact-band-title" class="container-page pb-24">
  <div class="relative isolate flex flex-wrap items-center justify-between gap-6 overflow-hidden rounded-[32px] bg-linear-to-br from-[#6d3fd6] to-[#36188a] p-8 md:px-12 md:py-14">
    <div aria-hidden="true" class="absolute -right-24 -bottom-40 -z-10 size-[360px] rounded-t-full bg-white/[0.06]"></div>
    <div class="flex flex-col gap-1">
      <p class="m-0 text-sm font-semibold text-[#ffd9c2]">{eyebrow}</p>
      <h2 id="contact-band-title" class="m-0 text-h2 font-bold text-white">{title}</h2>
    </div>
    <a
      href={href}
      class="group inline-flex min-h-12 items-center gap-2 rounded-control bg-white px-6 text-base font-semibold text-[#36188a] no-underline transition-transform duration-100 hover:text-[#36188a] focus-visible:outline-white active:scale-[0.97]"
    >
      {cta}
      <ArrowRight aria-hidden="true" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
    </a>
  </div>
</section>
