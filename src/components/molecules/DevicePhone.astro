---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BatteryFull from '@lucide/astro/icons/battery-full';
import Signal from '@lucide/astro/icons/signal';
import Wifi from '@lucide/astro/icons/wifi';

type Props = {
  image: ImageMetadata;
  alt: string;
  screen?: 'brand' | 'light';
  // « regular » dans les études de cas, « compact » posé à côté de l'ordinateur dans la vitrine
  size?: 'regular' | 'compact';
  loading?: 'lazy' | 'eager';
  class?: string;
};

const { image, alt, screen = 'light', size = 'regular', loading = 'lazy', class: className } = Astro.props;

// Les couleurs reprennent le haut et le bas de chaque capture pour que la barre d'état s'y fonde
const screenClasses = {
  // Texte sombre sur le vert : le blanc n'atteindrait pas le contraste AA à cette taille
  brand: 'bg-[#0DA479] text-[#0F1F1A]',
  light: 'bg-[#F4FCFB] text-[#0F1F1A]'
} as const;

const sizes = {
  regular: {
    frame: 'max-w-[250px] rounded-[48px] p-[9px]',
    screen: 'rounded-[39px]',
    statusBar: 'h-11 px-6 text-[13px]',
    island: 'top-2.5 h-[26px]',
    icon: 13,
    battery: 17,
    homeBar: 'h-6 pb-2',
    imageSizes: '232px'
  },
  compact: {
    frame: 'rounded-[26px] p-[5px]',
    screen: 'rounded-[21px]',
    statusBar: 'h-6 px-3.5 text-[8px]',
    island: 'top-1.5 h-[13px]',
    icon: 8,
    battery: 10,
    homeBar: 'h-3.5 pb-1',
    imageSizes: '160px'
  }
} as const;
const variant = sizes[size];
---

<!-- Maquette d'iPhone dessinée en CSS : châssis, boutons latéraux, Dynamic Island et barre d'accueil -->
<div
  class:list={[
    'relative w-full bg-linear-to-b from-[#3B3B43] via-[#1A1A1F] to-[#2A2A31] shadow-[0_40px_80px_-40px_rgb(30_15_69/0.55),inset_0_0_0_1.5px_rgb(255_255_255/0.08)]',
    variant.frame,
    className
  ]}
>
  <span aria-hidden="true" class="absolute top-[16%] -left-[3px] h-[5%] w-[3px] rounded-l-sm bg-[#26262C]"></span>
  <span aria-hidden="true" class="absolute top-[24%] -left-[3px] h-[9%] w-[3px] rounded-l-sm bg-[#26262C]"></span>
  <span aria-hidden="true" class="absolute top-[35%] -left-[3px] h-[9%] w-[3px] rounded-l-sm bg-[#26262C]"></span>
  <span aria-hidden="true" class="absolute top-[27%] -right-[3px] h-[13%] w-[3px] rounded-r-sm bg-[#26262C]"></span>

  <div class:list={['relative overflow-hidden', variant.screen, screenClasses[screen]]}>
    <div aria-hidden="true" class:list={['relative flex items-center justify-between font-semibold', variant.statusBar]}>
      <span>9:41</span>
      <span class:list={['absolute left-1/2 w-[34%] -translate-x-1/2 rounded-full bg-black', variant.island]}></span>
      <span class="flex items-center gap-1">
        <Signal size={variant.icon} stroke-width={2.5} />
        <Wifi size={variant.icon} stroke-width={2.5} />
        <BatteryFull size={variant.battery} stroke-width={2} />
      </span>
    </div>
    <Image src={image} alt={alt} widths={[250, 500]} sizes={variant.imageSizes} loading={loading} class="block h-auto w-full" />
    <div aria-hidden="true" class:list={['flex items-end justify-center', variant.homeBar]}>
      <span class="h-1 w-[36%] rounded-full bg-current opacity-80"></span>
    </div>
  </div>
</div>
