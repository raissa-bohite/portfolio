---
import type { ImageMetadata } from 'astro';
import DevicePhone from '@/components/molecules/DevicePhone.astro';

type Props = {
  image: ImageMetadata;
  alt: string;
  caption: string;
  screen?: 'brand' | 'light';
};

const { image, alt, caption, screen = 'light' } = Astro.props;
---

<figure data-scroll-item class="m-0 flex flex-col items-center gap-4">
  <DevicePhone image={image} alt={alt} screen={screen} />
  <figcaption class="text-center text-sm font-medium text-muted">{caption}</figcaption>
</figure>
