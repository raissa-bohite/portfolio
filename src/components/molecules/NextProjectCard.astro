---
import ArrowRight from '@lucide/astro/icons/arrow-right';

type Props = { href: string; label: string; name: string; kind: string };
const { href, label, name, kind } = Astro.props;
---

<section aria-label={label} class="container-page pb-24">
  <a
    href={href}
    class="glass group flex flex-wrap items-center justify-between gap-6 bg-glass-strong! px-10 py-8 no-underline transition-transform duration-200 ease-out-soft hover:-translate-y-1"
  >
    <span class="flex flex-col gap-1">
      <span class="text-sm font-semibold text-action">{label}</span>
      <span class="text-[clamp(24px,3vw,36px)] leading-tight font-bold tracking-[-0.015em] text-ink">{name}</span>
      <span class="text-[15px] text-muted">{kind}</span>
    </span>
    <span aria-hidden="true" class="flex size-14 items-center justify-center rounded-control bg-action text-action-ink transition-transform duration-200 group-hover:translate-x-1">
      <ArrowRight size={22} />
    </span>
  </a>
</section>
