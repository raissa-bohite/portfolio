---
// Logos de marque (LinkedIn, GitHub) : Lucide ne les fournit plus. Les fichiers SVG servent de masque CSS,
// le logo prend donc la couleur du texte (currentColor) et suit le thème clair ou sombre
type Props = { brand: 'linkedin' | 'github'; class?: string };

const { brand, class: className } = Astro.props;
---

<span aria-hidden="true" class:list={['brand-icon inline-block flex-none bg-current', `brand-icon-${brand}`, className]}></span>
