---
import Maximize from '@lucide/astro/icons/maximize-2';
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  image: ImageMetadata;
  alt: string;
  host: string;
  enlargeLabel: string;
  caption?: string;
  sizes: string;
  priority?: boolean;
};

const { image, alt, host, enlargeLabel, caption, sizes, priority = false } = Astro.props;
// Version grand format servie seulement à l'ouverture de l'aperçu
const largeImage = await getImage({ src: image, width: 1920, format: 'webp' });
---

<!-- Fenêtre de navigateur dessinée en CSS : la capture est présentée comme un vrai site, et s'agrandit au clic -->
<figure data-scroll-item class="m-0 flex flex-col gap-3">
  <div class="overflow-hidden rounded-[18px] border border-glass-border bg-glass-strong shadow-glass">
    <div aria-hidden="true" class="flex items-center gap-3 border-b border-line px-4 py-2.5">
      <span class="flex gap-1.5">
        <span class="size-2.5 rounded-full bg-[#ff5f57]"></span>
        <span class="size-2.5 rounded-full bg-[#febc2e]"></span>
        <span class="size-2.5 rounded-full bg-[#28c840]"></span>
      </span>
      <span class="mx-auto max-w-[60%] truncate rounded-full bg-tint px-4 py-0.5 font-mono text-xs text-tint-ink">{host}</span>
      <span class="w-[42px]"></span>
    </div>
    <button
      type="button"
      data-lightbox-src={largeImage.src}
      data-lightbox-alt={alt}
      data-lightbox-caption={caption ?? ''}
      aria-label={enlargeLabel}
      class="group relative block w-full cursor-zoom-in border-0 bg-white p-0"
    >
      <Image
        src={image}
        alt={alt}
        widths={[640, 1200, 1800]}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="block h-auto w-full transition-transform duration-700 ease-out-soft group-hover:scale-[1.015]"
      />
      <span
        aria-hidden="true"
        class="absolute right-4 bottom-4 flex size-10 items-center justify-center rounded-full bg-ink/80 text-bg opacity-0 transition-opacity group-hover:opacity-100 group-focus-visible:opacity-100"
      >
        <Maximize size={18} />
      </span>
    </button>
  </div>
  {caption && <figcaption class="text-sm font-semibold text-muted">{caption}</figcaption>}
</figure>
