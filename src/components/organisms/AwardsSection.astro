---
import Medal from '@lucide/astro/icons/medal';
import Trophy from '@lucide/astro/icons/trophy';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const awards = getDictionary(locale).aboutPage.awards;
---

<section aria-labelledby="awards-title" class="container-page flex flex-col gap-10 py-22">
  <SectionIntro id="awards-title" eyebrow={awards.eyebrow} title={awards.title} highlight={false} cursor />
  <ul data-scroll-group class="m-0 grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-4">
    {
      awards.items.map((award) => {
        const isFirst = award.rank === 'first';
        const Icon = isFirst ? Trophy : Medal;
        return (
          <li data-scroll-item class="flex flex-col gap-3 rounded-surface border border-glass-border bg-glass-strong p-6 shadow-glass">
            <span
              class:list={[
                'inline-flex items-center gap-2.5 self-start rounded-full py-1.5 pr-3.5 pl-1.5 text-sm font-extrabold',
                isFirst ? 'bg-[#fde8dc] text-[#9e3409] dark:bg-[#4a2318] dark:text-[#ffc7a6]' : 'bg-tint text-tint-ink'
              ]}
            >
              <span aria-hidden="true" class:list={['flex size-[30px] items-center justify-center rounded-full text-white', isFirst ? 'bg-sig' : 'bg-brand']}>
                <Icon size={16} />
              </span>
              {award.badge}
            </span>
            <h3 class="m-0 mt-1.5 text-title font-extrabold text-ink">{award.title}</h3>
            <p class="m-0 text-base text-text">{award.text}</p>
            <p class="m-0 mt-auto border-t border-dashed border-[#cdbff3] pt-3.5 text-sm font-semibold text-action dark:border-white/20">{award.event}</p>
          </li>
        );
      })
    }
  </ul>
</section>
