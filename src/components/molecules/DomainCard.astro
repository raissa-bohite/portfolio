---
import Clapperboard from '@lucide/astro/icons/clapperboard';
import Languages from '@lucide/astro/icons/languages';
import Palette from '@lucide/astro/icons/palette';

type Props = {
  icon: string;
  title: string;
  text: string;
};

const { icon, title, text } = Astro.props;

// Chaque centre d'intérêt a sa vignette : icône en grand sur une couleur du design system
const variants = {
  design: { Icon: Palette, tile: 'bg-linear-to-br from-[#6d3fd6] to-[#4a23a0] text-white' },
  motion: { Icon: Clapperboard, tile: 'bg-linear-to-br from-[#f58a45] to-[#e0590c] text-[#1e0f45]' },
  languages: { Icon: Languages, tile: 'bg-tint text-tint-ink' }
} as const;
const variant = variants[icon as keyof typeof variants] ?? variants.design;
const { Icon } = variant;
---

<article data-scroll-item class="group flex flex-col gap-4">
  <div aria-hidden="true" class:list={['relative flex aspect-[16/10] items-center justify-center overflow-hidden rounded-surface', variant.tile]}>
    <span class="absolute -right-8 -bottom-10 opacity-20">
      <Icon size={180} stroke-width={1} />
    </span>
    <span data-scroll-pop class="relative flex size-20 items-center justify-center rounded-[22px] bg-white/90 text-[#1e0f45] shadow-glass transition-transform duration-500 ease-out-soft group-hover:-translate-y-1">
      <Icon size={36} stroke-width={1.75} />
    </span>
  </div>
  <div class="flex flex-col gap-2">
    <h3 class="m-0 text-2xl leading-tight font-bold tracking-[-0.015em] text-ink">{title}</h3>
    <p class="m-0">{text}</p>
  </div>
</article>
