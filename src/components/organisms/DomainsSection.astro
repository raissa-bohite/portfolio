---
import Check from '@lucide/astro/icons/check';
import Sparkle from '@lucide/astro/icons/sparkle';
import Tag from '@/components/atoms/Tag.astro';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import dashboardIllustration from '@/assets/illustrations/dashboard.svg';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const domains = dictionary.home.domains;
const skillsLabel = dictionary.projectPage.stack;
// Même langage que la galerie des projets : une vignette colorée qui porte le visuel, le texte en dessous
const tileClasses = 'relative aspect-[4/3] overflow-hidden rounded-surface';
const floatClasses = 'absolute transition-transform duration-500 ease-out-soft group-hover:-translate-x-1.5 group-hover:-translate-y-1.5';
---

<section aria-labelledby="domains-title" class="container-page flex flex-col gap-12 py-24">
  <SectionHeading id="domains-title" eyebrow={domains.eyebrow} title={domains.title} />
  <div data-scroll-group class="grid gap-x-8 gap-y-14 md:grid-cols-3">
    {
      domains.items.map((domain) => (
        <article data-scroll-item class="group flex flex-col gap-5">
          {domain.icon === 'dashboard' && (
            <div aria-hidden="true" class={`${tileClasses} bg-linear-to-br from-[#6d3fd6] to-[#4a23a0]`}>
              <div class={`${floatClasses} top-[16%] left-[12%] w-[112%] overflow-hidden rounded-tl-[14px] bg-white shadow-[0_24px_50px_-18px_rgb(0_0_0/0.5)]`}>
                <div class="flex gap-1 border-b border-[#ece6f6] px-2.5 py-1.5">
                  <span class="size-1.5 rounded-full bg-[#ff5f57]" />
                  <span class="size-1.5 rounded-full bg-[#febc2e]" />
                  <span class="size-1.5 rounded-full bg-[#28c840]" />
                </div>
                <img src={dashboardIllustration.src} alt="" width="640" height="400" loading="lazy" decoding="async" class="block h-auto w-full" />
              </div>
            </div>
          )}

          {domain.icon === 'security' && (
            <div aria-hidden="true" class={`${tileClasses} bg-tint dark:bg-[#2a1a5c]`}>
              <pre
                class={`${floatClasses} top-[14%] left-[10%] m-0 w-[104%] rounded-tl-[14px] bg-[#1e0f45] p-5 font-mono text-[12px] leading-[1.75] text-[#d6ccf2] shadow-[0_24px_50px_-18px_rgb(30_15_69/0.6)]`}
              ><span class="text-[#9c90c4]">// contact-handler.ts</span>
if (!isSameOrigin(request))
  return jsonResponse(403, …);
const parsed = contactSchema
  .safeParse(payload);

<span class="text-[#9c90c4]">// headers</span>
<span class="text-[#ff9a5c]">Content-Security-Policy</span>:
  default-src 'self'</pre>
            </div>
          )}

          {domain.icon === 'ai' && (
            <div aria-hidden="true" class={`${tileClasses} bg-linear-to-br from-[#f58a45] to-[#e0590c]`}>
              <div class={`${floatClasses} top-[14%] left-[12%] flex w-full flex-col gap-3 rounded-tl-[14px] bg-white p-5 shadow-[0_24px_50px_-18px_rgb(80_20_0/0.45)]`}>
                <div class="flex items-center gap-2 self-end rounded-full bg-[#e7deff] px-4 py-2.5">
                  <span class="h-2 w-24 rounded-full bg-[#4a23a0]/70" />
                  <span class="h-2 w-10 rounded-full bg-[#4a23a0]/40" />
                </div>
                <div class="flex items-start gap-3">
                  <span class="flex size-8 flex-none items-center justify-center rounded-full bg-[#f26a1b] text-white">
                    <Sparkle size={16} />
                  </span>
                  <div class="flex flex-1 flex-col gap-2 rounded-2xl rounded-tl-sm bg-[#faf8ff] p-3.5">
                    <span class="h-2 w-[85%] rounded-full bg-[#1e0f45]/70" />
                    <span class="h-2 w-[65%] rounded-full bg-[#1e0f45]/35" />
                    <span class="h-2 w-[75%] rounded-full bg-[#1e0f45]/35" />
                  </div>
                </div>
                <div class="flex items-center gap-2 pl-11">
                  <span class="flex size-5 items-center justify-center rounded-full bg-[#28c840] text-white">
                    <Check size={12} />
                  </span>
                  <span class="h-2 w-20 rounded-full bg-[#28c840]/50" />
                </div>
              </div>
            </div>
          )}

          <div class="flex flex-col gap-3">
            <h3 class="m-0 text-title font-bold text-ink">{domain.title}</h3>
            <p class="m-0">{domain.text}</p>
            <ul class="m-0 mt-1 flex list-none flex-wrap gap-2 p-0" aria-label={skillsLabel}>
              {domain.skills.map((skill) => (
                <li>
                  <Tag>{skill}</Tag>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</section>
