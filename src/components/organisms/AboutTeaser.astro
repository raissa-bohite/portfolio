---
import { Image } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Code from '@lucide/astro/icons/code-xml';
import GraduationCap from '@lucide/astro/icons/graduation-cap';
import Rocket from '@lucide/astro/icons/rocket';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Sprout from '@lucide/astro/icons/sprout';
import ClosingBand from '@/components/molecules/ClosingBand.astro';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import type { Locale } from '@/i18n/config';
import { getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';
import portraitLaptop from '@/assets/portrait/portrait-laptop.png';
import fassbarPhone from '@/assets/projects/fassbar-phone.png';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const about = dictionary.home.about;
const aboutPage = dictionary.aboutPage;
const steps = aboutPage.timeline.steps;
// La dernière phrase de « Mon histoire » résume le fil conducteur du parcours
const storyQuote = aboutPage.story.paragraphs.at(-1);
const stepIcons = [GraduationCap, Code, ShieldCheck, Rocket];
---

<section aria-labelledby="about-title" class="relative overflow-hidden">
  <span aria-hidden="true" class="absolute top-10 right-[6%] hidden h-16 w-20 bg-[radial-gradient(circle,#b9a4f5_2px,transparent_2.5px)] bg-size-[21px_21px] md:block"></span>

  <div class="container-page relative flex flex-col gap-8 py-20">
    <div class="flex flex-wrap items-end gap-6">
      <div class="flex flex-[1_1_440px] flex-col gap-4 pb-6 md:pb-10">
        <SectionIntro id="about-title" eyebrow={about.eyebrow} title={about.title} intro={about.text} highlight={false} cursor />
      </div>
      <!-- Portrait ordinateur en main, mis en valeur comme sur la page À propos : halo, arche lavande ombrée, photo rognée à l'arche, sans l'arc orange réservé aux hauts de page. Décoratif -->
      <div aria-hidden="true" class="relative hidden flex-[1_1_420px] sm:block">
        <div class="relative isolate ml-auto aspect-[46/54] w-full max-w-[460px]">
          <span class="absolute -inset-x-[12%] top-[8%] -bottom-[6%] -z-10 rounded-full bg-[radial-gradient(closest-side,rgb(185_164_245/0.75),transparent)] dark:bg-[radial-gradient(closest-side,rgb(109_63_214/0.45),transparent)]"></span>
          <span class="absolute right-[6%] bottom-0 left-[6%] h-[74%] rounded-t-full rounded-b-[32px] bg-linear-to-br from-[#e4dafd] to-[#b9a4f5] shadow-[0_40px_80px_-20px_rgb(74_35_160/0.45)] dark:from-[#cbbcf7] dark:to-[#9b80ea]"></span>
          <span class="absolute inset-y-0 right-[6%] left-[6%] overflow-hidden rounded-b-[32px]">
            <Image
              src={portraitLaptop}
              alt=""
              widths={[460, 920]}
              sizes="(min-width: 640px) 460px, 1px"
              loading="lazy"
              class="absolute bottom-0 left-1/2 h-auto w-[104%] max-w-none -translate-x-1/2 drop-shadow-[0_18px_24px_rgb(30_15_69/0.35)]"
            />
          </span>
          <span class="absolute bottom-[4%] -left-[4%] -z-10 size-24 bg-[radial-gradient(circle,#b9a4f5_2px,transparent_2.5px)] bg-size-[16px_16px]"></span>
        </div>
      </div>
    </div>

    <ol data-scroll-group data-progress="y" data-progress-min-width="768px" aria-label={aboutPage.timeline.title} class="relative m-0 flex list-none flex-col gap-7 p-0">
      <!-- Axe de la frise : à gauche sur mobile, au centre à partir du format tablette -->
      <li data-progress-track aria-hidden="true" class="absolute top-0 bottom-0 left-[29px] w-0.5 bg-[#d9cef9] md:left-1/2 md:-ml-px dark:bg-white/15"></li>
      <!-- Remplissage de l'axe au défilement (scroll-progress.ts), plein quand l'animation est désactivée -->
      <li data-progress-fill aria-hidden="true" class="absolute top-0 bottom-0 left-[29px] w-0.5 bg-linear-to-b from-brand via-brand to-sig md:left-1/2 md:-ml-px"></li>
      {
        steps.map((step, index) => {
          const Icon = stepIcons[index] ?? Code;
          const isCurrent = index === steps.length - 1;
          const isLeft = index % 2 === 0;
          return (
            <li data-scroll-item class="relative grid grid-cols-[60px_minmax(0,1fr)] items-center gap-x-6 gap-y-4 md:grid-cols-[minmax(0,1fr)_60px_minmax(0,1fr)]">
              <span
                data-progress-step
                aria-hidden="true"
                class:list={[
                  'relative col-start-1 row-start-1 flex size-[60px] items-center justify-center rounded-full text-white shadow-[0_0_0_8px_var(--bg)] md:col-start-2',
                  isCurrent ? 'bg-sig' : 'bg-linear-to-br from-[#8b63ea] to-brand-deep'
                ]}
              >
                <Icon size={26} />
              </span>
              <article
                class:list={[
                  'col-start-2 row-start-1 flex gap-5 rounded-[20px] bg-glass-strong p-6 shadow-glass',
                  isLeft ? 'md:col-start-1' : 'md:col-start-3',
                  isCurrent ? 'border-2 border-[#f5a25d]' : 'border border-glass-border'
                ]}
              >
                <div class="flex min-w-0 flex-1 flex-col gap-2.5">
                  <span
                    class:list={[
                      'self-start rounded-full px-3 py-1 text-sm font-bold',
                      isCurrent ? 'bg-[#fde8dc] text-sig-text dark:bg-[#4a2318]' : 'bg-tint text-tint-ink'
                    ]}
                  >
                    {step.period}
                  </span>
                  <h3 class="m-0 text-subtitle font-extrabold text-ink">{step.title}</h3>
                  <p class="m-0 text-sm font-semibold text-action">{step.place}</p>
                </div>
                <div aria-hidden="true" class="hidden w-36 flex-none overflow-hidden rounded-2xl sm:block">
                  {index === 0 && (
                    <span class="flex h-full items-center justify-center bg-linear-to-br from-[#f3effd] to-[#ddd2fa] text-brand">
                      <GraduationCap size={56} />
                    </span>
                  )}
                  {index === 1 && (
                    <span class="flex h-full items-center justify-center bg-[#1b1530] text-lilac">
                      <Code size={56} />
                    </span>
                  )}
                  {index === 2 && (
                    <span class="flex h-full items-center justify-center bg-linear-to-br from-[#8b63ea] to-brand-deep text-white">
                      <ShieldCheck size={56} />
                    </span>
                  )}
                  {isCurrent && (
                    <span class="relative flex h-full items-end justify-center overflow-hidden bg-linear-to-br from-[#f3effd] to-[#ddd2fa] px-3 pt-4 dark:from-[#2a1c55] dark:to-[#1e1344]">
                      <span class="absolute top-1/2 left-1/2 aspect-square w-[90%] -translate-1/2 rounded-full bg-[radial-gradient(closest-side,rgb(13_164_121/0.22),transparent)]"></span>
                      <span class="absolute top-3 right-3 size-2.5 rounded-full bg-sig"></span>
                      <Image src={fassbarPhone} alt="" widths={[150, 300]} sizes="120px" loading="lazy" class="relative -mb-6 h-auto w-full max-w-[120px] drop-shadow-[0_10px_14px_rgb(30_15_69/0.25)]" />
                    </span>
                  )}
                </div>
              </article>
              {index === 0 && storyQuote && (
                <p class="col-start-2 m-0 text-body-lg text-action italic md:col-start-3 md:row-start-1 md:pl-5">« {storyQuote} »</p>
              )}
            </li>
          );
        })
      }
    </ol>

    <ClosingBand title={aboutPage.awards.title} class="mt-5 lg:pr-40">
      <Sprout slot="icon" size={32} />
      <ul class="m-0 flex list-none flex-wrap gap-2 p-0 text-sm font-semibold text-tint-ink">
        {
          aboutPage.awards.items.map((award) => (
            <li class="rounded-full bg-white px-3.5 py-1.5 dark:bg-white/10">
              {award.title}
              {award.rank !== 'first' && <span class="font-medium text-text"> · {award.badge}</span>}
            </li>
          ))
        }
      </ul>
      <a
        slot="aside"
        href={getRoutePath('about', locale)}
        class="relative inline-flex min-h-12 items-center gap-3 rounded-full bg-action px-6 text-base font-bold text-action-ink no-underline transition-colors hover:bg-action-hover"
      >
        {about.link}
        <ArrowRight aria-hidden="true" size={18} />
      </a>
    </ClosingBand>
  </div>
</section>
