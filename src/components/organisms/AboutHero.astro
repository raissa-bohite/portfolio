---
import { Image } from 'astro:assets';
import Download from '@lucide/astro/icons/download';
import MapPin from '@lucide/astro/icons/map-pin';
import portrait from '@/assets/portrait/portrait-cutout.png';
import Button from '@/components/atoms/Button.astro';
import Eyebrow from '@/components/atoms/Eyebrow.astro';
import type { Locale } from '@/i18n/config';
import { getCvPath, getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const page = dictionary.aboutPage;
---

<section data-scroll-group class="container-page pt-16 pb-24">
  <div class="grid items-center gap-x-6 gap-y-12 lg:grid-cols-12">
    <div class="flex flex-col gap-6 lg:col-span-7">
      <div data-scroll-item class="flex flex-col gap-3">
        <Eyebrow>{page.eyebrow}</Eyebrow>
        <h1 class="m-0 text-display font-bold text-ink">{page.title}</h1>
      </div>
      <p data-scroll-item class="m-0 max-w-[52ch] text-lead">{page.intro}</p>
      <!-- Sur mobile, chaque bouton occupe toute la largeur : côte à côte, les libellés passaient sur deux lignes -->
      <div data-scroll-item class="grid gap-3 sm:flex sm:flex-wrap">
        <Button href={getCvPath(locale)} download class="cta-pair">
          <Download aria-hidden="true" size={18} />
          {dictionary.common.cv}
        </Button>
        <Button href={getRoutePath('contact', locale)} variant="secondary" class="cta-pair">{page.contactCta}</Button>
      </div>
    </div>
    <!-- Même mise en scène que l'accueil : portrait détouré sur l'arche violette, lieu en badge flottant -->
    <div class="lg:col-span-5">
      <div class="relative mx-auto aspect-square w-full max-w-[440px]">
        <div aria-hidden="true" class="absolute right-[7%] bottom-0 left-[7%] h-[80%] rounded-t-full bg-linear-to-b from-[#6d3fd6] to-[#4a23a0]"></div>
        <div aria-hidden="true" class="absolute top-[4%] right-[6%] size-14 rounded-full border-[3px] border-sig"></div>
        <Image
          src={portrait}
          alt={dictionary.meta.portraitAlt}
          widths={[440, 880]}
          sizes="(min-width: 1024px) 440px, 90vw"
          loading="eager"
          fetchpriority="high"
          class="absolute bottom-0 left-[3%] w-[94%]"
        />
        <p data-scroll-pop class="absolute bottom-[12%] left-0 m-0 inline-flex items-center gap-2.5 rounded-full border border-glass-border bg-bg py-2 pr-4 pl-2 text-sm font-semibold text-ink shadow-glass-sm sm:-left-6">
          <span class="flex size-8 items-center justify-center rounded-full bg-tint text-sig-text">
            <MapPin aria-hidden="true" size={16} />
          </span>
          {page.location}
        </p>
      </div>
    </div>
  </div>
</section>
