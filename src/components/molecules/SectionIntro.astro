---
import { splitTitleAccent } from '@/lib/title-accent';

type Props = {
  id: string;
  eyebrow: string;
  title: string;
  intro?: string;
  // Couleur du sur-titre et du titre posés sur un fond violet
  onDark?: boolean;
  // Sans mise en couleur : utile pour un titre très court comme « Mes projets »
  highlight?: boolean;
  // Curseur orange après le titre, comme en haut de page : la ponctuation commune à toutes les sections
  cursor?: boolean;
  // « page » : titre principal de la page (h1, taille display) ; « section » par défaut (h2)
  level?: 'page' | 'section';
  // Permet d'élargir le bloc quand un titre long passerait sur trois lignes
  class?: string;
};

const { id, eyebrow, title, intro, onDark = false, highlight = true, cursor = false, level = 'section', class: className } = Astro.props;
const Heading = level === 'page' ? 'h1' : 'h2';
const { lead, accent } = highlight ? splitTitleAccent(title) : { lead: title, accent: '' };
---

<!-- En-tête de section commun : sur-titre en capitales suivi d'un trait, titre dont la fin passe en violet -->
<div class:list={['flex flex-col gap-3', className ?? 'max-w-[56ch]']}>
  <p class:list={['m-0 flex items-center gap-3 text-sm font-semibold tracking-[0.12em] uppercase', onDark ? 'text-[#ffd9c2]' : 'text-action']}>
    {eyebrow}
    <span aria-hidden="true" class:list={['h-0.5 w-12 rounded-full', onDark ? 'bg-[#ffd9c2]' : 'bg-linear-to-r from-brand to-lilac']}></span>
  </p>
  <Heading id={id} data-split-title class:list={['m-0 font-bold text-balance', level === 'page' ? 'text-display' : 'text-h2', onDark ? 'text-white' : 'text-ink']}>
    {lead}{lead && accent && ' '}{accent && <span class={onDark ? 'text-[#ffd9c2]' : 'text-action'}>{accent}</span>}
    {cursor && <span data-section-cursor aria-hidden="true" class="ml-1 inline-block h-[0.08em] w-[0.45em] bg-sig align-baseline" />}
  </Heading>
  {intro && <p class="m-0 max-w-[60ch] text-lead">{intro}</p>}
</div>
