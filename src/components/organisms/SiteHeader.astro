---
import logoMark from '@/assets/brand/rb-mark.svg';
import logoMarkDark from '@/assets/brand/rb-mark-dark.svg';
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Menu from '@lucide/astro/icons/menu';
import X from '@lucide/astro/icons/x';
import IconButton from '@/components/atoms/IconButton.astro';
import LanguageSwitcher from '@/components/molecules/LanguageSwitcher.astro';
import ThemeToggle from '@/components/molecules/ThemeToggle.astro';
import type { Locale } from '@/i18n/config';
import { getRoutePath, type AlternateLink, type RouteId } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';

type Props = {
  locale: Locale;
  currentRoute?: RouteId | undefined;
  alternates: AlternateLink[];
};

const { locale, currentRoute, alternates } = Astro.props;
const dictionary = getDictionary(locale);
const links: { id: RouteId; label: string }[] = [
  { id: 'home', label: dictionary.nav.home },
  { id: 'projects', label: dictionary.nav.projects },
  { id: 'about', label: dictionary.nav.about },
  { id: 'contact', label: dictionary.nav.contact }
];
---

<header class="sticky top-4 z-20 pt-4">
  <div class="container-page">
    <nav aria-label={dictionary.nav.label} class="material relative flex items-center justify-between gap-4 py-2.5 pr-2.5 pl-6">
      <a href={getRoutePath('home', locale)} class="flex items-center gap-2.5 text-xl font-extrabold tracking-[-0.02em] text-ink no-underline hover:text-ink">
        <!-- Logo décoratif : le nom qui suit suffit à nommer le lien ; une version éclaircie pour le thème sombre -->
        <img src={logoMark.src} alt="" width="36" height="36" class="size-9 dark:hidden" />
        <img src={logoMarkDark.src} alt="" width="36" height="36" class="hidden size-9 dark:block" />
        <span>Raïssa Bohité<span aria-hidden="true" class="animate-blink font-mono text-sig">_</span></span>
      </a>

      <ul id="primary-links" data-menu class="m-0 hidden list-none items-center gap-1 p-0 text-small font-semibold lg:flex">
        {
          links.map((link) => (
            <li>
              <a
                href={getRoutePath(link.id, locale)}
                aria-current={link.id === currentRoute ? 'page' : undefined}
                class:list={[
                  'inline-flex min-h-11 items-center rounded-control px-4 no-underline',
                  link.id === currentRoute ? 'bg-tint text-ink' : 'text-text hover:bg-tint hover:text-ink'
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <div class="flex items-center gap-2">
        <div class="hidden sm:block">
          <LanguageSwitcher currentLocale={locale} alternates={alternates} label={dictionary.nav.language} />
        </div>
        <ThemeToggle labelDark={dictionary.nav.themeDark} labelLight={dictionary.nav.themeLight} />
        <a
          href={getRoutePath('contact', locale)}
          class="hidden min-h-11 items-center gap-2 rounded-control bg-action px-[18px] transition-[background-color,transform] duration-150 active:scale-[0.97] text-small font-semibold text-action-ink no-underline hover:bg-action-hover hover:text-action-ink md:inline-flex"
        >
          {dictionary.nav.cta}
          <ArrowUpRight aria-hidden="true" size={16} />
        </a>
        <IconButton
          label={dictionary.nav.menuOpen}
          class="group lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-menu"
          data-menu-toggle
          data-label-open={dictionary.nav.menuOpen}
          data-label-close={dictionary.nav.menuClose}
        >
          <Menu aria-hidden="true" size={18} class="group-aria-expanded:hidden" />
          <X aria-hidden="true" size={18} class="hidden group-aria-expanded:block" />
        </IconButton>
      </div>

      <div id="mobile-menu" hidden class="absolute top-full right-0 left-0 mt-2 rounded-surface border border-glass-border bg-bg p-4 shadow-glass lg:hidden">
        <ul class="m-0 flex list-none flex-col gap-1 p-0 text-base font-semibold">
          {
            links.map((link) => (
              <li>
                <a
                  href={getRoutePath(link.id, locale)}
                  aria-current={link.id === currentRoute ? 'page' : undefined}
                  class:list={[
                    'flex min-h-12 items-center rounded-control px-4 no-underline',
                    link.id === currentRoute ? 'bg-tint text-ink' : 'text-text hover:bg-tint hover:text-ink'
                  ]}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-3 border-t border-line pt-3 sm:hidden">
          <LanguageSwitcher currentLocale={locale} alternates={alternates} label={dictionary.nav.language} />
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');

  function setMenuOpen(open: boolean): void {
    if (!toggle || !menu) return;
    menu.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
    const label = open ? toggle.dataset['labelClose'] : toggle.dataset['labelOpen'];
    if (label) toggle.setAttribute('aria-label', label);
  }

  toggle?.addEventListener('click', () => setMenuOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      toggle.focus();
    }
  });
</script>
