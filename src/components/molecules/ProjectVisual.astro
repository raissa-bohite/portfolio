---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import MiniBrowser from '@/components/molecules/MiniBrowser.astro';
import MiniPhone from '@/components/molecules/MiniPhone.astro';
import type { ProjectSummary } from '@/lib/projects';

type Props = {
  project: ProjectSummary;
  actionLabel: string;
  featured?: boolean;
  // Proportions de la vignette, réglables selon la mise en page qui l'accueille
  aspectClass?: string;
};

const { project, actionLabel, featured = false, aspectClass } = Astro.props;
const phoneShots = project.shotFrame === 'phone' ? project.shots : [];
const desktopShots = project.shotFrame === 'desktop' ? project.shots : [];
// Téléphones en escalier à droite de la capture principale, le dernier coupé par le bord comme sur un « shot »
const phonePositions = [
  'top-[20%] left-[70%] group-hover:-translate-y-3',
  'top-[9%] left-[83%] group-hover:-translate-y-1',
  'top-[26%] left-[96%] group-hover:-translate-y-4'
];

// Fonds aux couleurs de marque de chaque projet : la galerie montre d'emblée des univers différents
const accentClasses = {
  mint: 'bg-[#0da479]',
  crimson: 'bg-[#c8323f]',
  forest: 'bg-[#2f5b45]',
  gold: 'bg-[#e0940f]',
  royal: 'bg-[#1e4fc4]'
} as const;
---

<!-- Vignette façon « shot » : les captures flottent sur la couleur du projet, coupées par le bord, et se soulèvent au survol -->
<div
  class:list={[
    'relative overflow-hidden rounded-surface',
    accentClasses[project.accent],
    aspectClass ?? (featured ? 'aspect-[4/3] md:aspect-[21/9]' : 'aspect-[4/3]')
  ]}
>
  <div aria-hidden="true" class="absolute inset-0 bg-[radial-gradient(120%_90%_at_0%_0%,rgb(255_255_255/0.22),transparent_60%)]"></div>
  {
    phoneShots.length > 0 ? (
      <>
        <MiniBrowser
          image={project.cover}
          sizes="(min-width: 768px) 740px, 90vw"
          class="absolute top-[14%] left-[6%] w-[92%] transition-transform duration-500 ease-out-soft group-hover:-translate-y-2 md:left-[5%] md:w-[62%]"
        />
        {phoneShots.map((shot, index) => (
          <MiniPhone image={shot} class={`absolute hidden w-[12%] transition-transform duration-500 ease-out-soft md:block ${phonePositions[index] ?? ''}`} />
        ))}
      </>
    ) : desktopShots.length > 0 ? (
      <>
        <MiniBrowser
          image={project.cover}
          sizes="(min-width: 768px) 460px, 74vw"
          class="absolute top-[9%] left-[7%] w-[74%] transition-transform duration-500 ease-out-soft group-hover:-translate-y-2"
        />
        {desktopShots[0] && (
          <MiniBrowser
            image={desktopShots[0]}
            sizes="(min-width: 768px) 360px, 58vw"
            class="absolute top-[36%] left-[39%] z-10 w-[58%] transition-transform duration-500 ease-out-soft group-hover:translate-x-2"
          />
        )}
        {desktopShots[1] && (
          <MiniBrowser
            image={desktopShots[1]}
            sizes="(min-width: 768px) 260px, 42vw"
            class="absolute top-[58%] left-[4%] z-20 w-[42%] transition-transform duration-500 ease-out-soft group-hover:translate-y-2"
          />
        )}
      </>
    ) : (
      <MiniBrowser
        image={project.cover}
        sizes={featured ? '(min-width: 1248px) 950px, 92vw' : '(min-width: 768px) 620px, 100vw'}
        class="absolute top-[16%] left-[10%] w-[110%] rounded-r-none rounded-b-none transition-transform duration-500 ease-out-soft group-hover:-translate-x-2 group-hover:-translate-y-2"
      />
    )
  }
  <span
    aria-hidden="true"
    class="absolute bottom-5 left-5 z-30 inline-flex translate-y-3 items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-[#1e0f45] opacity-0 shadow-lg transition duration-300 ease-out-soft group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100"
  >
    {actionLabel}
    <ArrowUpRight size={16} />
  </span>
</div>

