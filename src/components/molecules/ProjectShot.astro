---
import Tag from '@/components/atoms/Tag.astro';
import ProjectVisual from '@/components/molecules/ProjectVisual.astro';
import type { ProjectSummary } from '@/lib/projects';

type Props = {
  project: ProjectSummary;
  actionLabel: string;
  featured?: boolean;
};

const { project, actionLabel, featured = false } = Astro.props;
---

<!-- Vignette façon « shot » : la capture flotte sur la couleur du projet, coupée par le bord, et se soulève au survol -->
<article data-scroll-item class:list={['group relative flex flex-col gap-4', featured && 'md:col-span-2']}>
  <ProjectVisual project={project} actionLabel={actionLabel} featured={featured} />

  <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
    <div class="flex flex-col gap-1">
      <h3 class="m-0 text-2xl leading-tight font-bold tracking-[-0.015em] text-ink">
        <!-- Le lien couvre toute la vignette, mais son texte reste le nom du projet -->
        <a href={project.href} class="text-ink no-underline after:absolute after:inset-0 after:rounded-surface hover:text-action focus-visible:outline-none">
          {project.name}
        </a>
      </h3>
      <p class="m-0 text-[15px] text-muted">{project.kind}</p>
    </div>
    <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
      {
        project.stack.slice(0, 3).map((technology) => (
          <li>
            <Tag>{technology}</Tag>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  /* Le contour de focus s'affiche sur toute la vignette, pas seulement sur le nom */
  article:has(a:focus-visible) {
    outline: 3px solid var(--sig);
    outline-offset: 6px;
    border-radius: var(--radius-surface);
  }
</style>
