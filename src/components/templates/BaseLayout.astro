---
import '@/styles/global.css';
import SiteFooter from '@/components/organisms/SiteFooter.astro';
import PageLoader from '@/components/organisms/PageLoader.astro';
import SiteHeader from '@/components/organisms/SiteHeader.astro';
import { defaultLocale, locales, openGraphLocales, type Locale } from '@/i18n/config';
import type { AlternateLink, RouteId } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';
import { profile } from '@/lib/profile';
import pageInitScript from '@/scripts/page-init.inline.js?raw';
import themeInitScript from '@/scripts/theme-init.inline.js?raw';
import bricolageLatinUrl from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';

type Props = {
  locale: Locale;
  title: string;
  description: string;
  currentRoute?: RouteId;
  alternates: AlternateLink[];
  noindex?: boolean;
};

const { locale, title, description, currentRoute, alternates, noindex = false } = Astro.props;
const dictionary = getDictionary(locale);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const defaultAlternate = alternates.find((alternate) => alternate.locale === defaultLocale);
// Nom versionné : les réseaux sociaux gardent l'image en cache par adresse, changer le nom force la mise à jour
const socialImageUrl = new URL('/og-image-v2.jpg', Astro.site);

// Données structurées : aident les moteurs de recherche à relier le site à la personne
const personData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: dictionary.meta.homeTitle.split('·')[1]?.trim(),
  email: `mailto:${profile.email}`,
  url: Astro.site?.toString(),
  address: { '@type': 'PostalAddress', addressLocality: profile.city, addressCountry: profile.country },
  sameAs: [profile.linkedinUrl, profile.githubUrl],
  knowsLanguage: ['fr', 'de', 'en']
};
---

<!doctype html>
<html lang={locale} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <!-- Preuve de propriété pour Google Search Console : jeton public, sans valeur secrète -->
    <meta name="google-site-verification" content="FqCqeY-ciIdBt6zx50m7P2d-uKdiA68I2iOeFPioA5M" />
    <link rel="canonical" href={canonicalUrl} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={new URL(alternate.path, Astro.site)} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.path, Astro.site)} />}
    <!-- Police principale préchargée : le texte du haut de page s'affiche plus tôt dans sa forme finale -->
    <link rel="preload" href={bricolageLatinUrl} as="font" type="font/woff2" crossorigin />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#F4F0FC" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <!-- Dimensions et type déclarés : Facebook, WhatsApp et LinkedIn affichent l'aperçu dès le premier partage -->
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:secure_url" content={socialImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={dictionary.meta.socialImageAlt} />
    <meta property="og:locale" content={openGraphLocales[locale]} />
    {locales.filter((otherLocale) => otherLocale !== locale).map((otherLocale) => <meta property="og:locale:alternate" content={openGraphLocales[otherLocale]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={dictionary.meta.socialImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(personData)} />

    <!-- Appliqué avant l'affichage pour éviter un flash du mauvais thème -->
    <script is:inline set:html={themeInitScript} />
    <!-- Décide avant l'affichage s'il faut montrer le chargeur (première visite) ou lever le rideau (changement de page) -->
    <script is:inline set:html={pageInitScript} />
  </head>
  <!-- Pas d'overflow sur body : html coupe déjà le débordement horizontal (clip), et un body « hidden » deviendrait le conteneur de défilement, ce qui casse l'en-tête collant -->
  <body class="relative min-h-screen">
    <a href="#main" class="sr-only z-50 rounded-control bg-action px-4 py-3 font-semibold text-action-ink focus:not-sr-only focus:fixed focus:top-4 focus:left-4">
      {dictionary.nav.skip}
    </a>
    <PageLoader locale={locale} />
    <!-- Halos colorés réservés au thème sombre : le thème clair reste sur un fond blanc uni -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden overflow-hidden dark:block">
      <div class="absolute -top-[200px] -left-[240px] size-[760px] rounded-full bg-orb-1 opacity-85 blur-[120px]"></div>
      <div class="absolute top-[300px] -right-[200px] size-[600px] rounded-full bg-orb-2 opacity-70 blur-[130px]"></div>
      <div class="absolute top-[2000px] left-1/5 size-[700px] rounded-full bg-orb-1 opacity-60 blur-[140px]"></div>
    </div>
    <SiteHeader locale={locale} currentRoute={currentRoute} alternates={alternates} />
    <main id="main" tabindex="-1" class="relative">
      <slot />
    </main>
    <SiteFooter locale={locale} />
  </body>
</html>

<script>
  // Toutes les pages partagent la même révélation au défilement : les sections la déclarent par data-scroll-group
  import { setupPageTransitions } from '@/scripts/page-transition';
  import { setupScrollReveal } from '@/scripts/scroll-reveal';

  setupPageTransitions();
  for (const group of document.querySelectorAll<HTMLElement>('[data-scroll-group]')) setupScrollReveal(group);
</script>
