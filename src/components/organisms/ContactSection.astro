---
import { Image } from 'astro:assets';
import BriefcaseBusiness from '@lucide/astro/icons/briefcase-business';
import FolderGit from '@lucide/astro/icons/folder-git-2';
import Heart from '@lucide/astro/icons/heart';
import Mail from '@lucide/astro/icons/mail';
import MapPin from '@lucide/astro/icons/map-pin';
import MessageSquare from '@lucide/astro/icons/message-square';
import Undo2 from '@lucide/astro/icons/undo-2';
import Zap from '@lucide/astro/icons/zap';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import ContactForm from '@/components/organisms/ContactForm.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import { profile } from '@/lib/profile';
import portraitDesk from '@/assets/portrait/portrait-desk.png';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const contact = dictionary.home.contact;
const highlightIcons = { zap: Zap, message: MessageSquare, heart: Heart } as const;
// Lucide ne fournit plus de logos de marque : des pictogrammes neutres, le nom reste écrit en clair
const socialLinks = [
  { label: 'LinkedIn', href: profile.linkedinUrl, Icon: BriefcaseBusiness },
  { label: 'GitHub', href: profile.githubUrl, Icon: FolderGit }
];
---

<section id="contact" aria-labelledby="contact-title" class="relative overflow-hidden">
  <span aria-hidden="true" class="absolute top-8 right-6 hidden h-16 w-20 bg-[radial-gradient(circle,#b9a4f5_2px,transparent_2.5px)] bg-size-[21px_21px] md:block"></span>
  <span aria-hidden="true" class="absolute top-20 right-36 hidden size-4 rounded-full bg-sig md:block"></span>

  <div class="container-page relative flex flex-col gap-10 pt-20 pb-10">
    <div class="grid items-stretch gap-8 lg:grid-cols-[minmax(0,17rem)_minmax(0,1fr)_minmax(0,24rem)]">
      <div class="flex flex-col gap-5">
        <!-- Le titre déborde sur le haut de la colonne photo, vide à cet endroit : il tient ainsi sur deux lignes -->
        <div class="relative z-10 lg:w-[25rem]">
          <SectionIntro id="contact-title" eyebrow={contact.eyebrow} title={contact.title} intro={contact.text} highlight={false} cursor="dot" />
        </div>
        <ul class="m-0 mt-2 flex list-none flex-col gap-5 p-0">
          {
            contact.highlights.map((highlight) => {
              const Icon = highlightIcons[highlight.icon as keyof typeof highlightIcons] ?? Zap;
              return (
                <li class="flex gap-4">
                  <span aria-hidden="true" class="flex size-12 flex-none items-center justify-center rounded-full bg-tint text-tint-ink">
                    <Icon size={20} />
                  </span>
                  <span class="flex flex-col gap-1">
                    <strong class="text-[0.9375rem] font-bold text-ink">{highlight.title}</strong>
                    <span class="text-sm text-text">{highlight.text}</span>
                  </span>
                </li>
              );
            })
          }
        </ul>
        <div class="relative max-w-full pt-6">
          <p class="m-0 -rotate-[8deg] font-hand text-[1.625rem] leading-[1.15] font-semibold text-action">{contact.note}</p>
          <span aria-hidden="true" class="mt-2.5 ml-16 block h-[3px] w-28 -rotate-[6deg] rounded-full bg-sig"></span>
          <Undo2 aria-hidden="true" size={34} class="absolute right-0 -bottom-8 hidden -rotate-[100deg] text-action sm:block" />
        </div>
      </div>

      <!--
        Photo au bureau, grande, entre le texte et le formulaire : le disque violet passe derrière le buste et s'arrête
        net à la ligne du bureau, un halo lavande sous la plante, la bulle de discussion près du visage.
        Décorative et affichée seulement en grand format : comme sur la maquette, l'ordinateur passe sous la carte du formulaire,
        ce qui permet d'agrandir la photo sans toucher le texte.
      -->
      <div aria-hidden="true" class="relative -mr-32 -ml-7 hidden self-end lg:block">
        <div class="relative aspect-[1217/1090] w-full">
          <span class="absolute -bottom-[4%] left-[2%] aspect-square w-[38%] rounded-full bg-tint/70 dark:bg-tint/50"></span>
          <span class="absolute inset-0 overflow-hidden">
            <span class="absolute top-[24%] left-[13%] aspect-square w-[80%] rounded-full bg-linear-to-br from-[#7b4fe0] to-brand-deep"></span>
          </span>
          <Image
            src={portraitDesk}
            alt=""
            widths={[480, 960]}
            sizes="(min-width: 1024px) 600px, 1px"
            loading="lazy"
            class="absolute bottom-0 left-0 h-auto w-full"
          />
          <span class="absolute top-[4%] right-[30%] flex h-[58px] w-[82px] items-center justify-center gap-2 rounded-[18px] bg-brand shadow-[0_12px_26px_rgb(74_35_160/0.3)]">
            <span class="size-[9px] rounded-full bg-white"></span>
            <span class="size-[9px] rounded-full bg-white"></span>
            <span class="size-[9px] rounded-full bg-white"></span>
            <span class="absolute -bottom-2 left-6 size-4 rotate-45 rounded-[3px] bg-brand"></span>
          </span>
        </div>
      </div>

      <div class="relative z-10 self-center rounded-surface border border-glass-border bg-[var(--material)] p-5 shadow-glass-lg sm:p-7">
        <ContactForm locale={locale} variant="card" class="relative" />
      </div>
    </div>

    <!-- Coordonnées : email, ville et réseaux, sur un bandeau lavande -->
    <div class="relative isolate flex flex-wrap items-center gap-x-7 gap-y-5 overflow-hidden rounded-surface bg-tint/60 px-6 py-7 sm:px-11 dark:bg-tint">
      <span aria-hidden="true" class="absolute -bottom-8 -left-7 -z-10 size-[70px] rounded-full bg-[#f5a25d]"></span>
      <span aria-hidden="true" class="absolute -right-8 -bottom-10 -z-10 size-[90px] rounded-full bg-brand"></span>
      <a href={`mailto:${profile.email}`} class="flex min-h-12 flex-[1_1_260px] items-center gap-4 font-semibold text-ink underline underline-offset-4">
        <span aria-hidden="true" class="flex size-12 flex-none items-center justify-center rounded-full bg-brand text-white">
          <Mail size={20} />
        </span>
        {profile.email}
      </a>
      <span aria-hidden="true" class="hidden h-[52px] w-px bg-[#d9cef9] md:block dark:bg-white/15"></span>
      <p class="m-0 flex flex-[1_1_220px] items-center gap-4 font-semibold text-ink">
        <span aria-hidden="true" class="flex size-12 flex-none items-center justify-center rounded-full bg-brand text-white">
          <MapPin size={20} />
        </span>
        {dictionary.aboutPage.location}
      </p>
      <span aria-hidden="true" class="hidden h-[52px] w-px bg-[#d9cef9] md:block dark:bg-white/15"></span>
      <ul class="m-0 flex list-none flex-wrap gap-2.5 p-0 sm:mr-10">
        {
          socialLinks.map(({ label, href, Icon }) => (
            <li>
              <a
                href={href}
                rel="me noopener"
                class="flex min-h-[46px] items-center gap-2.5 rounded-full bg-white py-1.5 pr-5 pl-1.5 text-small font-semibold text-tint-ink no-underline dark:bg-white/10"
              >
                <span aria-hidden="true" class="flex size-[34px] items-center justify-center rounded-full bg-tint">
                  <Icon size={18} />
                </span>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
