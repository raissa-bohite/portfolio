---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import FeaturedProject from '@/components/molecules/FeaturedProject.astro';
import ProjectCard from '@/components/molecules/ProjectCard.astro';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import type { Locale } from '@/i18n/config';
import { getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';
import type { ProjectSummary } from '@/lib/projects';

type Props = { locale: Locale; projects: ProjectSummary[] };

const { locale, projects } = Astro.props;
const dictionary = getDictionary(locale);
const section = dictionary.home.projects;
const [featuredProject, ...otherProjects] = projects;
---

<!-- Galerie de l'accueil : le premier projet en grand, les suivants en cartes -->
<section aria-labelledby="projects-title" class="container-page relative flex flex-col gap-10 pt-16 pb-20">
  <!--
    Décor du haut de section : forme lavande coupée par le bord haut, pastille orange et grille de points.
    Le conteneur rogne la forme pour qu'elle ne déborde pas sur le bandeau des technologies.
  -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden overflow-hidden md:block">
    <div class="absolute -top-24 left-[58%] size-44 rounded-full bg-linear-to-b from-[#b9a4f5]/15 to-[#b9a4f5]/55"></div>
    <div class="absolute top-16 left-[63%] size-4 rounded-full bg-sig"></div>
    <div class="absolute top-6 right-6 size-20 bg-[radial-gradient(circle,#b9a4f5_1.8px,transparent_2px)] bg-size-[20px_20px]"></div>
  </div>

  <div class="flex flex-wrap items-end justify-between gap-6">
    <SectionIntro id="projects-title" eyebrow={section.eyebrow} title={section.title} intro={section.intro} highlight={false} cursor />
    <a href={getRoutePath('projects', locale)} class="group inline-flex min-h-12 items-center gap-3 text-base font-semibold text-action no-underline">
      <span class="underline decoration-[1.5px] underline-offset-[6px]">{dictionary.common.allProjects}</span>
      <span aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-tint text-tint-ink transition-transform duration-200 group-hover:translate-x-1">
        <ArrowRight size={18} />
      </span>
    </a>
  </div>

  <div data-scroll-group class="flex flex-col gap-6">
    {
      featuredProject && (
        <FeaturedProject
          project={featuredProject}
          labels={{ viewProject: dictionary.common.viewProject, caseStudy: dictionary.common.caseStudy, newTab: dictionary.common.newTab }}
          note={section.featuredNote}
        />
      )
    }
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {otherProjects.map((project) => <ProjectCard project={project} actionLabel={dictionary.common.viewProject} />)}
    </div>
  </div>

</section>
