---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'> & {
  href: string;
  variant?: 'primary' | 'secondary';
};

const { href, variant = 'primary', class: className, ...attributes } = Astro.props;

const variantClasses = {
  primary: 'bg-action text-action-ink hover:bg-action-hover hover:text-action-ink',
  secondary: 'border-[1.5px] border-action bg-glass-strong text-action hover:text-action-hover'
} as const;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-12 items-center gap-2 rounded-control px-6 text-base font-semibold no-underline transition-colors duration-200 ease-out-soft',
    variantClasses[variant],
    className
  ]}
  {...attributes}
>
  <slot />
</a>
