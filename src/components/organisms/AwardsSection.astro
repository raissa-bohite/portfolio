---
import Medal from '@lucide/astro/icons/medal';
import Trophy from '@lucide/astro/icons/trophy';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const awards = getDictionary(locale).aboutPage.awards;
---

<!-- Même langage que la galerie : une vignette colorée qui porte le visuel, le texte en dessous -->
<section aria-labelledby="awards-title" class="container-page flex flex-col gap-12 pb-24">
  <SectionHeading id="awards-title" eyebrow={awards.eyebrow} title={awards.title} />
  <ul data-scroll-group class="m-0 grid list-none gap-x-6 gap-y-10 p-0 sm:grid-cols-2 lg:grid-cols-4">
    {
      awards.items.map((award) => {
        const isFirst = award.rank === 'first';
        const Icon = isFirst ? Trophy : Medal;
        return (
          <li data-scroll-item class="flex flex-col gap-4">
            <div
              class:list={[
                'relative flex aspect-[4/3] flex-col justify-between overflow-hidden rounded-surface p-5',
                isFirst ? 'bg-linear-to-br from-[#f58a45] to-[#e0590c] text-[#1e0f45]' : 'bg-tint text-tint-ink'
              ]}
            >
              <span aria-hidden="true" class="absolute -right-6 -bottom-8 opacity-25">
                <Icon size={140} stroke-width={1.25} />
              </span>
              <span class="relative flex size-11 items-center justify-center rounded-full bg-white text-[#1e0f45]">
                <Icon aria-hidden="true" size={20} />
              </span>
              <span class="relative text-title leading-none font-bold">{award.badge}</span>
            </div>
            <div class="flex flex-col gap-1.5">
              <h3 class="m-0 text-subtitle font-bold text-ink">{award.title}</h3>
              <p class="m-0">{award.text}</p>
              <p class="m-0 text-sm text-muted">{award.event}</p>
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
