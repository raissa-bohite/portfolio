---
import Check from '@lucide/astro/icons/check';
import LayoutDashboard from '@lucide/astro/icons/layout-dashboard';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Sparkles from '@lucide/astro/icons/sparkles';
import Sparkle from '@lucide/astro/icons/sparkle';
import Target from '@lucide/astro/icons/target';
import Tag from '@/components/atoms/Tag.astro';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import dashboardIllustration from '@/assets/illustrations/dashboard.svg';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const domains = dictionary.home.domains;
const skillsLabel = dictionary.projectPage.stack;
const tileClasses = 'relative aspect-[16/10] overflow-hidden rounded-[18px]';
const floatClasses = 'absolute transition-transform duration-500 ease-out-soft group-hover:-translate-x-1.5 group-hover:-translate-y-1.5';
const domainIcons = { dashboard: LayoutDashboard, security: ShieldCheck, ai: Sparkles } as const;
const iconTileClasses = {
  dashboard: 'bg-tint text-tint-ink',
  security: 'bg-tint text-tint-ink',
  ai: 'bg-sig/10 text-sig-text',
} as const;
---

<section aria-labelledby="domains-title" class="border-y border-line bg-linear-to-b from-tint/35 to-bg py-16 sm:py-20">
  <div class="container-page flex flex-col gap-9 sm:gap-11">
    <SectionIntro id="domains-title" eyebrow={domains.eyebrow} title={domains.title} />
    <div data-scroll-group class="grid items-stretch gap-5 lg:grid-cols-3">
      {domains.items.map((domain, index) => {
        const Icon = domainIcons[domain.icon as keyof typeof domainIcons] ?? Sparkles;
        const iconTile = iconTileClasses[domain.icon as keyof typeof iconTileClasses] ?? iconTileClasses.dashboard;
        return (
          <article data-scroll-item class="group flex min-w-0 flex-col overflow-hidden rounded-surface border border-line bg-bg shadow-glass-sm transition-[transform,box-shadow] duration-300 ease-out-soft hover:-translate-y-1 hover:shadow-glass">
            <div class="flex items-center justify-between px-5 pt-5 sm:px-6 sm:pt-6">
              <span class="rounded-full bg-tint px-3 py-1 font-mono text-xs font-semibold text-tint-ink">{String(index + 1).padStart(2, '0')}</span>
              <span aria-hidden="true" class:list={['flex size-10 items-center justify-center rounded-[12px]', iconTile]}>
                <Icon size={20} />
              </span>
            </div>

            <div class="px-5 pt-4 sm:px-6">
              {domain.icon === 'dashboard' && (
                <div aria-hidden="true" class={`${tileClasses} bg-linear-to-br from-brand to-brand-deep`}>
                  <div class={`${floatClasses} top-[14%] left-[10%] w-[112%] overflow-hidden rounded-tl-[14px] bg-bg shadow-glass-lg`}>
                    <div class="flex gap-1 border-b border-line px-2.5 py-1.5">
                      <span class="size-1.5 rounded-full bg-sig" />
                      <span class="size-1.5 rounded-full bg-lilac" />
                      <span class="size-1.5 rounded-full bg-brand-deep" />
                    </div>
                    <img src={dashboardIllustration.src} alt="" width="640" height="400" loading="lazy" decoding="async" class="block h-auto w-full" />
                  </div>
                </div>
              )}
              {domain.icon === 'security' && (
                <div aria-hidden="true" class={`${tileClasses} bg-tint`}>
                  <div class={`${floatClasses} top-[12%] left-[8%] w-[104%] rounded-tl-[14px] bg-brand-deeper p-4 font-mono text-[11px] leading-[1.8] text-white shadow-glass-lg sm:p-5 sm:text-xs`}>
                    <p class="m-0 text-lilac">// contact-handler.ts</p>
                    <p class="m-0">if (!isSameOrigin(request))</p>
                    <p class="m-0 pl-3 text-sig">return jsonResponse(403)</p>
                    <p class="m-0 mt-2">const parsed = contactSchema</p>
                    <p class="m-0 pl-3">.safeParse(payload)</p>
                    <div class="mt-3 rounded-lg border border-white/15 bg-white/5 px-3 py-2">
                      <span class="text-sig">Content-Security-Policy</span>
                      <p class="m-0 text-white/75">default-src 'self'</p>
                    </div>
                  </div>
                </div>
              )}
              {domain.icon === 'ai' && (
                <div aria-hidden="true" class={`${tileClasses} bg-sig/10`}>
                  <div class={`${floatClasses} top-[12%] left-[10%] flex w-full flex-col gap-3 rounded-tl-[14px] border border-line bg-bg p-4 shadow-glass-lg sm:p-5`}>
                    <div class="flex items-center gap-2 self-end rounded-full bg-tint px-3 py-2">
                      <span class="h-2 w-20 rounded-full bg-brand-deep/70" />
                      <span class="h-2 w-8 rounded-full bg-brand/40" />
                    </div>
                    <div class="flex items-start gap-3">
                      <span class="flex size-8 flex-none items-center justify-center rounded-full bg-sig text-white">
                        <Sparkle size={16} />
                      </span>
                      <div class="flex flex-1 flex-col gap-2 rounded-2xl rounded-tl-sm bg-tint/50 p-3">
                        <span class="h-2 w-[85%] rounded-full bg-ink/70" />
                        <span class="h-2 w-[65%] rounded-full bg-muted/50" />
                        <span class="h-2 w-[75%] rounded-full bg-muted/50" />
                      </div>
                    </div>
                    <div class="flex items-center gap-2 pl-11">
                      <span class="flex size-5 items-center justify-center rounded-full bg-brand-deep text-white">
                        <Check size={12} />
                      </span>
                      <span class="h-2 w-20 rounded-full bg-brand/40" />
                    </div>
                  </div>
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col px-5 pb-5 pt-5 sm:px-6 sm:pb-6">
              <h3 class="m-0 text-xl font-bold leading-snug text-ink">{domain.title}</h3>
              <p class="mb-0 mt-2 text-base">{domain.text}</p>
              <ul class="mt-4 flex list-none flex-col gap-2 border-t border-line pt-4" aria-label={skillsLabel}>
                {domain.skills.map((skill) => (
                  <li class="flex items-start gap-2 text-sm text-text">
                    <span aria-hidden="true" class="mt-0.5 flex size-5 flex-none items-center justify-center rounded-full bg-tint text-tint-ink">
                      <Check size={12} />
                    </span>
                    <span>{skill}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-auto flex flex-wrap gap-2 border-t border-line pt-4" aria-label={skillsLabel}>
                {domain.skills.slice(0, 3).map((skill) => <Tag>{skill}</Tag>)}
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <div class="relative flex flex-col items-start gap-4 overflow-hidden rounded-block bg-linear-to-br from-brand-deep to-brand-deeper p-6 text-white sm:flex-row sm:items-center sm:gap-7 sm:p-8">
      <div aria-hidden="true" class="absolute right-8 top-5 size-3 rounded-full bg-sig"></div>
      <div aria-hidden="true" class="absolute -bottom-16 -right-10 size-40 rounded-full bg-white/10"></div>
      <span aria-hidden="true" class="flex size-12 flex-none items-center justify-center rounded-[14px] bg-white/15">
        <Target size={22} />
      </span>
      <p class="relative m-0 max-w-[22ch] text-xl font-bold leading-snug">{domains.closing.title}</p>
      <span aria-hidden="true" class="hidden h-16 w-px flex-none bg-white/20 sm:block"></span>
      <p class="relative m-0 max-w-[62ch] text-sm leading-relaxed text-white/80 sm:text-base">{domains.closing.text}</p>
    </div>
  </div>
</section>
