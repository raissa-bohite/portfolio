---
type Props = {
  id: string;
  name: string;
  label: string;
  kind?: 'input' | 'textarea' | 'select';
  type?: 'text' | 'email';
  autocomplete?: string;
  placeholder?: string;
  help?: string;
  error: string;
  required?: boolean;
  minLength?: number;
  maxLength: number;
  rows?: number;
  options?: { value: string; label: string }[];
  class?: string;
};

const {
  id,
  name,
  label,
  kind = 'input',
  type = 'text',
  autocomplete,
  placeholder,
  help,
  error,
  required = true,
  minLength,
  maxLength,
  rows = 4,
  options = [],
  class: className
} = Astro.props;

const helpId = help ? `${id}-help` : undefined;
const errorId = `${id}-error`;
const describedBy = [helpId].filter(Boolean).join(' ') || undefined;
// Icône facultative posée dans le champ : le texte se décale pour lui laisser la place
const hasIcon = Astro.slots.has('icon');
const controlClasses =
  'w-full rounded-control border-[1.5px] border-line bg-glass-strong px-4 font-sans text-base text-ink placeholder:text-muted hover:border-muted aria-invalid:border-danger';
---

<div class:list={['flex flex-col gap-2', className]} data-field>
  <label for={id} class="text-sm font-semibold text-ink">
    {label}
    {required && <span aria-hidden="true" class="text-sig-text"> *</span>}
  </label>
  <div class="relative">
    {
      hasIcon && (
        <span
          aria-hidden="true"
          class:list={['pointer-events-none absolute left-4 flex text-muted', kind === 'textarea' ? 'top-3.5' : 'top-1/2 -translate-y-1/2']}
        >
          <slot name="icon" />
        </span>
      )
    }
    {
      kind === 'textarea' ? (
        <textarea
          id={id}
          name={name}
          rows={rows}
          required={required}
          minlength={minLength}
          maxlength={maxLength}
          aria-describedby={describedBy}
          data-error-id={errorId}
          class:list={[controlClasses, 'block resize-y py-3', hasIcon && 'pl-12']}
        />
      ) : kind === 'select' ? (
        <select
          id={id}
          name={name}
          required={required}
          aria-describedby={describedBy}
          data-error-id={errorId}
          class:list={[controlClasses, 'min-h-12', hasIcon && 'pl-12']}
        >
          {options.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </select>
      ) : (
        <input
          id={id}
          name={name}
          type={type}
          autocomplete={autocomplete}
          placeholder={placeholder}
          required={required}
          minlength={minLength}
          maxlength={maxLength}
          aria-describedby={describedBy}
          data-error-id={errorId}
          class:list={[controlClasses, 'min-h-12', hasIcon && 'pl-12']}
        />
      )
    }
  </div>
  {help && <p id={helpId} class="m-0 text-sm text-muted">{help}</p>}
  <p id={errorId} class="m-0 hidden text-sm font-medium text-danger" data-error-message={error}></p>
</div>
