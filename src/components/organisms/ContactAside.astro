---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Copy from '@lucide/astro/icons/copy';
import Download from '@lucide/astro/icons/download';
import type { Locale } from '@/i18n/config';
import { getCvPath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';
import { profile } from '@/lib/profile';

type Props = { locale: Locale; class?: string };

const { locale, class: className } = Astro.props;
const dictionary = getDictionary(locale);
const page = dictionary.contactPage;
const links = [
  { href: profile.linkedinUrl, label: 'LinkedIn', external: true },
  { href: profile.githubUrl, label: 'GitHub', external: true },
  { href: getCvPath(locale), label: dictionary.common.cv, external: false }
];
---

<aside data-scroll-group class:list={['flex flex-col gap-4', className]}>
  <div data-scroll-item class="glass flex flex-col gap-3 p-6" data-copy-email data-copied={page.copied} data-copy-failed={page.copyFailed}>
    <h2 class="m-0 text-sm font-semibold text-sig-text">{page.directEmail}</h2>
    <a href={`mailto:${profile.email}`} data-email class="text-[17px] font-semibold [overflow-wrap:anywhere] underline-offset-[5px]">{profile.email}</a>
    <button
      type="button"
      data-copy-button
      hidden
      class="inline-flex min-h-11 cursor-pointer items-center gap-2 self-start rounded-control border border-line bg-glass-strong px-4 font-sans text-[15px] font-semibold text-ink transition-colors hover:bg-tint"
    >
      <Copy aria-hidden="true" size={16} />
      {page.copy}
    </button>
    <p data-copy-status role="status" class="m-0 min-h-px text-sm text-muted"></p>
  </div>

  <nav data-scroll-item aria-labelledby="elsewhere-title" class="glass flex flex-col gap-1 p-6">
    <h2 id="elsewhere-title" class="mt-0 mb-2 text-sm font-semibold text-sig-text">{page.elsewhere}</h2>
    {
      links.map((link, index) => (
        <a
          href={link.href}
          rel={link.external ? 'me noopener' : undefined}
          download={link.external ? undefined : true}
          class:list={['flex min-h-11 items-center justify-between font-semibold no-underline', index > 0 && 'border-t border-line']}
        >
          {link.label}
          {link.external ? <ArrowUpRight aria-hidden="true" size={18} /> : <Download aria-hidden="true" size={18} />}
        </a>
      ))
    }
  </nav>

  <div data-scroll-item class="glass flex flex-col gap-2 p-6">
    <h2 class="m-0 text-sm font-semibold text-sig-text">{page.whereWhen}</h2>
    <p class="m-0 font-semibold text-ink">{page.location}</p>
    <p class="m-0 text-[15px] text-muted">{page.timezone}</p>
  </div>
</aside>

<script>
  import { setupCopyEmail } from '@/scripts/copy-email';

  for (const block of document.querySelectorAll<HTMLElement>('[data-copy-email]')) setupCopyEmail(block);
</script>
