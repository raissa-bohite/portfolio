---
type Props = {
  label: string;
  facts: { term: string; value: string }[];
};

const { label, facts } = Astro.props;
---

<section aria-label={label}>
  <dl class:list={['glass m-0 grid gap-x-6 gap-y-5 px-8 py-6 sm:grid-cols-2', facts.length >= 4 && 'lg:grid-cols-4']}>
    {
      facts.map((fact) => (
        <div>
          <dt class="text-sm font-medium text-muted">{fact.term}</dt>
          <dd class="mt-1 mb-0 font-semibold text-ink">{fact.value}</dd>
        </div>
      ))
    }
  </dl>
</section>
