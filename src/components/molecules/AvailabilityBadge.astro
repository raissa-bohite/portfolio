---

type Props = {
  href: string;
  label: string;
};

const { href, label } = Astro.props;
---

<a
  href={href}
  data-reveal
  class="glass inline-flex min-h-11 items-center gap-2.5 self-start rounded-full! bg-glass-strong py-1.5 pr-4 pl-3.5 text-sm font-semibold text-ink no-underline hover:text-ink"
>
  <span aria-hidden="true" class="size-2 rounded-full bg-sig"></span>
  {label}
</a>
