---
import { Image } from 'astro:assets';
import portrait from '@/assets/portrait/portrait.jpg';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const about = dictionary.home.about;
---

<section aria-labelledby="about-title" class="container-page py-24">
  <div data-scroll-group class="glass grid items-center gap-x-6 gap-y-10 p-8 md:p-12 lg:grid-cols-12">
    <div class="flex justify-center lg:col-span-3">
      <Image
        data-scroll-mask
        src={portrait}
        alt={dictionary.meta.portraitAlt}
        widths={[240, 480]}
        sizes="240px"
        loading="lazy"
        class="block aspect-4/5 w-full max-w-60 rounded-surface border border-line bg-tint object-cover object-[50%_20%]"
      />
    </div>
    <div data-scroll-item class="flex flex-col gap-4 lg:col-span-4">
      <SectionHeading id="about-title" eyebrow={about.eyebrow} title={about.title} />
      <p class="m-0">{about.text}</p>
      <a href={getRoutePath('about', locale)} class="inline-flex min-h-12 items-center self-start text-base font-semibold underline-offset-[5px]">{about.link}</a>
    </div>
    <div class="relative lg:col-span-5">
      <span data-scroll-line aria-hidden="true" class="absolute top-6 bottom-6 left-[7px] w-0.5 rounded-full bg-line"></span>
      <ol class="relative m-0 list-none p-0">
        {
          about.timeline.map((milestone) => (
            <li data-scroll-item class="relative flex flex-col gap-0.5 py-4 pl-9">
              <span
                data-scroll-dot
                aria-hidden="true"
                class:list={[
                  'absolute top-[22px] left-0 size-4 rounded-full border-2',
                  milestone.current ? 'border-sig bg-sig shadow-[0_0_0_6px_rgb(242_106_27/0.18)]' : 'border-muted bg-bg'
                ]}
              />
              <span class:list={['text-sm', milestone.current ? 'font-semibold text-sig-text' : 'font-medium text-muted']}>{milestone.period}</span>
              <span class="text-ink">{milestone.text}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { setupScrollReveal } from '@/scripts/scroll-reveal';

  for (const group of document.querySelectorAll<HTMLElement>('[data-scroll-group]')) setupScrollReveal(group);
</script>
