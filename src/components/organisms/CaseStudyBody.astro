---
import Plus from '@lucide/astro/icons/plus';
import Tag from '@/components/atoms/Tag.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import type { CaseStudy } from '@/lib/projects';
import ScreenshotGallery from '@/components/organisms/ScreenshotGallery.astro';

type Props = { locale: Locale; caseStudy: CaseStudy };

const { locale, caseStudy } = Astro.props;
const labels = getDictionary(locale).projectPage;

const sectionNumber = (position: number): string => String(position).padStart(2, '0');
const labelClasses = 'm-0 font-mono text-sm font-semibold text-sig-text';
const headingClasses = 'm-0 text-h2 font-bold text-ink';
const splitClasses = 'container-page grid w-full scroll-mt-32 gap-6 lg:grid-cols-12 lg:gap-x-12';
const asideClasses = 'flex flex-col gap-3 lg:sticky lg:top-32 lg:col-span-4 lg:self-start';
const bodyClasses = 'flex flex-col gap-5 lg:col-span-8';
const paragraphClasses = 'm-0 max-w-[62ch] text-body-lg';
---

<article data-case-study class="flex flex-col gap-24 pb-24">
  <section id="context" data-scroll-group aria-labelledby="context-title" class={splitClasses}>
    <div data-scroll-item class={asideClasses}>
      <p class={labelClasses}>{sectionNumber(1)}</p>
      <h2 id="context-title" class={headingClasses}>{labels.sections.context}</h2>
    </div>
    <div data-scroll-item class={bodyClasses}>
      {caseStudy.context.map((paragraph) => <p class={paragraphClasses}>{paragraph}</p>)}
    </div>
  </section>

  <section id="role" data-scroll-group aria-labelledby="role-title" class={splitClasses}>
    <div data-scroll-item class={asideClasses}>
      <p class={labelClasses}>{sectionNumber(2)}</p>
      <h2 id="role-title" class={headingClasses}>{labels.sections.role}</h2>
    </div>
    <div class={bodyClasses}>
      {caseStudy.role.paragraphs.map((paragraph) => <p data-scroll-item class={paragraphClasses}>{paragraph}</p>)}
      <ul class="m-0 mt-2 grid list-none gap-3 p-0 sm:grid-cols-2">
        {
          caseStudy.role.highlights.map((highlight, index) => (
            <li data-scroll-item class="glass flex items-center gap-4 shadow-glass-sm! px-5 py-4 font-semibold text-ink">
              <span class="font-mono text-sm text-sig-text">{sectionNumber(index + 1)}</span>
              {highlight}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="approach" aria-labelledby="approach-title" class="flex scroll-mt-32 flex-col gap-14">
    <div data-scroll-group class={splitClasses}>
      <div data-scroll-item class={asideClasses}>
        <p class={labelClasses}>{sectionNumber(3)}</p>
        <h2 id="approach-title" class={headingClasses}>{labels.sections.approach}</h2>
      </div>
      <div data-scroll-item class={bodyClasses}>
        {caseStudy.approach.paragraphs.map((paragraph) => <p class={paragraphClasses}>{paragraph}</p>)}
      </div>
    </div>

      {caseStudy.approach.gallery.length > 0 && <ScreenshotGallery locale={locale} shots={caseStudy.approach.gallery} />}
  </section>

  <section id="technical" aria-labelledby="technical-title" class={splitClasses}>
    <div data-scroll-group class={asideClasses}>
      <p data-scroll-item class={labelClasses}>{sectionNumber(4)}</p>
      <h2 data-scroll-item id="technical-title" class={headingClasses}>{labels.sections.technical}</h2>
      <p data-scroll-item class="m-0 text-lg">{caseStudy.technical.intro}</p>
      <ul data-scroll-item class="m-0 mt-2 flex list-none flex-wrap gap-2 p-0" aria-label={labels.stack}>
        {
          caseStudy.technical.stack.map((technology) => (
            <li>
              <Tag>{technology}</Tag>
            </li>
          ))
        }
      </ul>
    </div>
    <!-- Les choix se lisent d'abord par leur titre : le détail s'ouvre à la demande, la page reste aérée -->
    <ol data-scroll-group class="m-0 flex list-none flex-col p-0 lg:col-span-8">
      {
        caseStudy.technical.decisions.map((decision, index) => (
          <li data-scroll-item class="border-b border-line first:border-t">
            <details class="group" open={index === 0}>
              <summary class="flex cursor-pointer list-none items-center gap-5 py-6 text-ink [&::-webkit-details-marker]:hidden">
                <span class="font-mono text-sm font-semibold text-sig-text">{sectionNumber(index + 1)}</span>
                <span class="flex-1 text-xl font-bold tracking-[-0.01em]">{decision.title}</span>
                <span class="flex size-9 flex-none items-center justify-center rounded-full bg-tint text-tint-ink transition-transform duration-300 group-open:rotate-45">
                  <Plus aria-hidden="true" size={18} />
                </span>
              </summary>
              <p class="m-0 max-w-[62ch] pb-6 pl-10 text-base leading-[1.7]">{decision.text}</p>
            </details>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Bandeau sombre dans les deux thèmes : les résultats ressortent dans le rythme de la page -->
  <!-- Résultats dans un bloc violet, comme le contact de l'accueil : couleurs fixes, contraste supérieur à 7:1 -->
  <section id="results" aria-labelledby="results-title" class="container-page w-full scroll-mt-32">
    <div data-scroll-group class="relative isolate flex flex-col gap-10 overflow-hidden rounded-block bg-linear-to-br from-[#6d3fd6] to-[#36188a] shadow-glass-lg p-8 md:p-12">
      <div aria-hidden="true" class="absolute -right-32 -bottom-40 -z-10 size-[420px] rounded-t-full bg-white/[0.06]"></div>
      <div data-scroll-item class="flex max-w-3xl flex-col gap-3">
        <p class="m-0 font-mono text-sm font-semibold text-[#ffd9c2]">{sectionNumber(5)}</p>
        <h2 id="results-title" class="m-0 text-h2 font-bold text-white">{labels.sections.results}</h2>
        <p class="m-0 text-lg text-white/85">{caseStudy.results.intro}</p>
      </div>
      <dl class="m-0 grid gap-x-8 gap-y-10 sm:grid-cols-2 xl:grid-cols-4">
        {
          caseStudy.results.metrics.map((metric) => (
            <div data-scroll-item class="flex flex-col gap-2 border-t-2 border-[#ff9a5c] pt-5">
              <dt class="order-2 m-0 text-small text-white/85">{metric.label}</dt>
              <dd class="order-1 m-0 text-[clamp(36px,3.8vw,56px)] leading-none font-bold tracking-[-0.03em] break-words text-white">{metric.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="learnings" data-scroll-group aria-labelledby="learnings-title" class={splitClasses}>
    <div data-scroll-item class={asideClasses}>
      <p class={labelClasses}>{sectionNumber(6)}</p>
      <h2 id="learnings-title" class={headingClasses}>{labels.sections.learnings}</h2>
    </div>
    <div class="flex flex-col gap-8 lg:col-span-8">
      {
        caseStudy.learnings.map((learning) => (
          <p data-scroll-item class="m-0 max-w-[58ch] border-l-4 border-sig pl-6 text-xl leading-[1.6] font-medium text-ink">
            {learning}
          </p>
        ))
      }
    </div>
  </section>
</article>

<div aria-hidden="true" class="fixed inset-x-0 top-0 z-30 h-[3px]">
  <div data-reading-progress class="h-full w-full origin-left scale-x-0 bg-sig"></div>
</div>

<script>
  import { setupReadingProgress } from '@/scripts/reading';

  const article = document.querySelector<HTMLElement>('[data-case-study]');
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  if (article && progress) setupReadingProgress(article, progress);
</script>
