---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Code from '@lucide/astro/icons/code-xml';
import PenTool from '@lucide/astro/icons/pen-tool';
import Search from '@lucide/astro/icons/search';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { formatMessage, getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const method = getDictionary(locale).home.method;
const heights = ['40%', '60%', '80%', '100%'];
// Sur mobile, une étape par ligne : les barres prennent leur hauteur naturelle, l'escalier n'existe qu'à partir de deux colonnes
const heightClasses = ['sm:h-[40%]', 'sm:h-[60%]', 'sm:h-[80%]', 'sm:h-full'];
// Une icône par étape : la barre se comprend sans lire le code
const stepIcons = [Search, PenTool, Code, ShieldCheck];
---

<!-- Bande lavande pleine largeur : elle rythme l'accueil comme la bande des captures sur les pages projet -->
<section aria-labelledby="method-title" class="bg-tint/45 py-24 dark:bg-white/[0.03]">
  <div class="container-page flex flex-col gap-12">
    <SectionHeading id="method-title" eyebrow={method.eyebrow} title={method.title} />
    <ol data-histogram aria-label={method.listLabel} class="m-0 grid list-none items-start gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {
        method.steps.map((step, index) => {
          const Icon = stepIcons[index] ?? Code;
          const isLast = index === method.steps.length - 1;
          return (
            <li class="flex flex-col gap-5">
              <!-- Même vignette que les distinctions de la page À propos : dégradé, icône dans une pastille blanche, grand pictogramme en filigrane -->
              <div class="relative flex items-end sm:h-56 lg:h-72">
                <div
                  data-bar
                  data-height={heights[index]}
                  class:list={[
                    'relative flex min-h-[132px] w-full flex-col justify-between overflow-hidden rounded-surface bg-linear-to-br from-[#6d3fd6] to-[#4a23a0] p-5 text-white shadow-glass transition-colors duration-300 [&.is-current]:from-[#f58a45] [&.is-current]:to-[#e0590c] [&.is-current]:text-[#1e0f45]',
                    heightClasses[index]
                  ]}
                >
                  <span aria-hidden="true" class="absolute -right-6 -bottom-8 opacity-20">
                    <Icon size={130} stroke-width={1.25} />
                  </span>
                  <span aria-hidden="true" class="relative flex size-10 items-center justify-center rounded-full bg-white text-[#1e0f45]">
                    <Icon size={18} />
                  </span>
                  <span class="relative flex flex-col gap-0.5">
                    <span class="font-mono text-base font-semibold" lang="fr">{step.code}</span>
                    <span class="text-sm font-semibold opacity-90">{formatMessage(method.step, { n: index + 1 })}</span>
                  </span>
                </div>
                {!isLast && (
                  <span
                    aria-hidden="true"
                    class="absolute -right-[22px] bottom-5 z-10 hidden size-8 items-center justify-center rounded-full border border-line bg-bg text-action shadow-glass-sm lg:flex"
                  >
                    <ArrowRight size={16} />
                  </span>
                )}
              </div>
              <div data-bar-text class="flex flex-col gap-3">
                <p class="m-0 text-base">{step.text}</p>
                <p class="m-0 flex flex-wrap items-center gap-2 text-sm">
                  <span class="font-semibold text-muted">{method.deliverableLabel}</span>
                  <span class="rounded-full border border-glass-border bg-bg px-3 py-1 font-semibold text-ink">{step.deliverable}</span>
                </p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<script>
  import { setupHistogram } from '@/scripts/histogram';

  for (const list of document.querySelectorAll<HTMLElement>('[data-histogram]')) setupHistogram(list);
</script>
