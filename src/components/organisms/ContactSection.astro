---
import Mail from '@lucide/astro/icons/mail';
import ContactForm from '@/components/organisms/ContactForm.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import { profile } from '@/lib/profile';

type Props = { locale: Locale };

const { locale } = Astro.props;
const contact = getDictionary(locale).home.contact;
// Le texte est posé sur le violet dans les deux thèmes : couleurs fixes, contraste supérieur à 7:1
const linkClasses = 'text-white underline decoration-white/50 underline-offset-[5px] hover:text-white hover:decoration-white focus-visible:outline-white';
---

<!-- Fin de page : un grand bloc violet qui reprend l'arche du haut de page, avec le formulaire dans une carte -->
<section id="contact" aria-labelledby="contact-title" class="container-page py-24">
  <div class="relative isolate grid gap-x-10 gap-y-10 overflow-hidden rounded-[32px] bg-linear-to-br from-[#6d3fd6] to-[#36188a] p-8 md:p-12 lg:grid-cols-12">
    <div aria-hidden="true" class="absolute -bottom-40 -left-32 -z-10 size-[420px] rounded-t-full bg-white/[0.06]"></div>

    <div class="flex flex-col gap-4 lg:col-span-5">
      <p class="m-0 text-sm font-semibold text-[#ffd9c2]">{contact.eyebrow}</p>
      <h2 id="contact-title" class="m-0 text-h2 font-bold text-white">{contact.title}</h2>
      <p class="m-0 text-lg text-white/85">{contact.text}</p>
      <a href={`mailto:${profile.email}`} class={`mt-2 inline-flex min-h-12 items-center gap-2.5 self-start text-[17px] font-semibold ${linkClasses}`}>
        <Mail aria-hidden="true" size={18} />
        {profile.email}
      </a>
      <ul class="m-0 flex list-none gap-6 p-0 text-base font-semibold">
        <li><a href={profile.linkedinUrl} rel="me noopener" class={`inline-flex min-h-11 items-center ${linkClasses}`}>LinkedIn</a></li>
        <li><a href={profile.githubUrl} rel="me noopener" class={`inline-flex min-h-11 items-center ${linkClasses}`}>GitHub</a></li>
      </ul>
    </div>

    <div class="rounded-surface bg-bg p-6 shadow-[0_30px_60px_-30px_rgb(0_0_0/0.5)] md:p-8 lg:col-span-7">
      <ContactForm locale={locale} variant="compact" class="relative" />
    </div>
  </div>
</section>
