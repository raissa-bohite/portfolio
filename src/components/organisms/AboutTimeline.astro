---
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const timeline = getDictionary(locale).aboutPage.timeline;
const lastIndex = timeline.steps.length - 1;
---

<!-- Bande lavande pleine largeur, comme « Ma démarche » sur l'accueil -->
<section aria-labelledby="timeline-title" class="mb-24 bg-tint/45 py-24 dark:bg-white/[0.03]">
  <div class="container-page grid w-full gap-x-6 gap-y-10 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <SectionHeading id="timeline-title" eyebrow={timeline.eyebrow} title={timeline.title} />
      <!-- Le parcours écrit comme un tableau : chaque ligne s'allume quand la frise atteint l'étape correspondante -->
      <figure aria-label={timeline.codeLabel} class="sticky top-36 m-0 mt-6 hidden lg:block">
        <div class="overflow-hidden rounded-surface border border-glass-border bg-bg shadow-glass">
          <div aria-hidden="true" class="flex items-center gap-2 border-b border-line px-4 py-3">
            <span class="size-2.5 rounded-full bg-sig"></span>
            <span class="size-2.5 rounded-full bg-line"></span>
            <span class="size-2.5 rounded-full bg-line"></span>
            <span class="ml-2 font-mono text-[13px] text-muted">parcours.ts</span>
          </div>
          <div lang="fr" class="overflow-x-auto px-5 pt-5 pb-6 font-mono text-sm leading-[1.9] text-ink [&>span]:whitespace-pre">
            <span class="block"><span class="text-action">const</span> parcours = [</span>
            {
              timeline.steps.map((step, index) => (
                <span data-code-step={index} class="-mx-2 block rounded-md px-2 transition-colors duration-300 data-[lit=true]:bg-sig/16">{`  `}<span class="text-sig-text">{`'${step.code}'`}</span>,</span>
              ))
            }
            <span class="block">];</span>
            <span class="block" aria-hidden="true">&nbsp;</span>
            <span class="block">parcours.<span class="text-action">forEach</span>(comprendre);</span>
          </div>
        </div>
        <figcaption class="mt-3 text-sm text-muted">{timeline.codeCaption}</figcaption>
      </figure>
    </div>

    <div data-timeline class="relative pl-10 lg:col-span-8">
      <div aria-hidden="true" class="absolute top-2 bottom-2 left-[11px] w-0.5 bg-line">
        <div data-timeline-fill class="h-full w-0.5 origin-top scale-y-0 bg-sig motion-reduce:scale-y-100"></div>
      </div>
      <ol class="m-0 list-none p-0">
        {
          timeline.steps.map((step, index) => (
            <li class="relative pb-8 last:pb-0">
              <span
                aria-hidden="true"
                class:list={[
                  'absolute top-1 -left-9 size-4 rounded-full border-2',
                  index === lastIndex ? 'border-sig bg-sig shadow-[0_0_0_6px_rgb(242_106_27/0.18)]' : 'border-muted bg-bg'
                ]}
              />
              <p class:list={['m-0 text-sm', index === lastIndex ? 'font-semibold text-sig-text' : 'font-medium text-muted']}>{step.period}</p>
              <h3 class="my-1 text-subtitle font-bold text-ink">{step.title}</h3>
              <p class="m-0">{step.place}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  import { setupTimelineProgress } from '@/scripts/timeline-progress';

  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  const fill = document.querySelector<HTMLElement>('[data-timeline-fill]');
  const codeLines = Array.from(document.querySelectorAll<HTMLElement>('[data-code-step]'));
  if (timeline && fill) setupTimelineProgress(timeline, fill, codeLines);
</script>
