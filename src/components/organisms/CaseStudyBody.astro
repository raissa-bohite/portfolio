---
import Tag from '@/components/atoms/Tag.astro';
import DecisionCard from '@/components/molecules/DecisionCard.astro';
import MetricCard from '@/components/molecules/MetricCard.astro';
import PhoneFrame from '@/components/molecules/PhoneFrame.astro';
import TableOfContents from '@/components/molecules/TableOfContents.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import type { CaseStudy } from '@/lib/projects';

type Props = { locale: Locale; caseStudy: CaseStudy };

const { locale, caseStudy } = Astro.props;
const labels = getDictionary(locale).projectPage;
const sections = [
  { id: 'context', title: labels.sections.context },
  { id: 'role', title: labels.sections.role },
  { id: 'approach', title: labels.sections.approach },
  { id: 'technical', title: labels.sections.technical },
  { id: 'results', title: labels.sections.results },
  { id: 'learnings', title: labels.sections.learnings }
] as const;
const paragraphClasses = 'm-0 max-w-[64ch]';
const headingClasses = 'm-0 text-[clamp(28px,3vw,36px)] leading-[1.15] font-bold tracking-[-0.015em] text-ink';
---

<div class="container-page pb-24">
  <div class="grid gap-6 lg:grid-cols-12">
    <TableOfContents title={labels.tocTitle} label={labels.tocLabel} items={sections} />

    <article data-case-study class="flex flex-col gap-[72px] lg:col-span-9">
      <section id="context" data-toc-section aria-labelledby="context-title" class="flex scroll-mt-32 flex-col gap-4">
        <h2 id="context-title" class={headingClasses}>{labels.sections.context}</h2>
        {caseStudy.context.map((paragraph) => <p class={paragraphClasses}>{paragraph}</p>)}
      </section>

      <section id="role" data-toc-section data-scroll-group aria-labelledby="role-title" class="flex scroll-mt-32 flex-col gap-4">
        <h2 id="role-title" class={headingClasses}>{labels.sections.role}</h2>
        {caseStudy.role.paragraphs.map((paragraph) => <p class={paragraphClasses}>{paragraph}</p>)}
        <ul class="m-0 mt-2 grid list-none gap-3 p-0 sm:grid-cols-2">
          {
            caseStudy.role.highlights.map((highlight) => (
              <li data-scroll-item class="glass flex items-center gap-3 px-5 py-4 font-semibold text-ink">
                <span aria-hidden="true" class="size-2 flex-none rounded-full bg-sig" />
                {highlight}
              </li>
            ))
          }
        </ul>
      </section>

      <section id="approach" data-toc-section data-scroll-group aria-labelledby="approach-title" class="flex scroll-mt-32 flex-col gap-4">
        <h2 id="approach-title" class={headingClasses}>{labels.sections.approach}</h2>
        {caseStudy.approach.paragraphs.map((paragraph) => <p class={paragraphClasses}>{paragraph}</p>)}
        {
          caseStudy.approach.gallery.length > 0 && (
            <div class="mt-2 grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-6">
              {caseStudy.approach.gallery.map((item) => (
                <PhoneFrame image={item.image} alt={item.alt} caption={item.caption} screen={item.screen} />
              ))}
            </div>
          )
        }
      </section>

      <section id="technical" data-toc-section data-scroll-group aria-labelledby="technical-title" class="flex scroll-mt-32 flex-col gap-4">
        <h2 id="technical-title" class={headingClasses}>{labels.sections.technical}</h2>
        <p class={paragraphClasses}>{caseStudy.technical.intro}</p>
        <div class="mt-2 grid gap-4 sm:grid-cols-2">
          {caseStudy.technical.decisions.map((decision) => <DecisionCard title={decision.title} text={decision.text} />)}
        </div>
        <ul class="m-0 mt-2 flex list-none flex-wrap gap-2 p-0" aria-label={labels.stack}>
          {
            caseStudy.technical.stack.map((technology) => (
              <li>
                <Tag>{technology}</Tag>
              </li>
            ))
          }
        </ul>
      </section>

      <section id="results" data-toc-section data-scroll-group aria-labelledby="results-title" class="flex scroll-mt-32 flex-col gap-4">
        <h2 id="results-title" class={headingClasses}>{labels.sections.results}</h2>
        <p class={paragraphClasses}>{caseStudy.results.intro}</p>
        <div class="mt-2 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {caseStudy.results.metrics.map((metric) => <MetricCard value={metric.value} label={metric.label} />)}
        </div>
      </section>

      <section id="learnings" data-toc-section aria-labelledby="learnings-title" class="flex scroll-mt-32 flex-col gap-4">
        <h2 id="learnings-title" class={headingClasses}>{labels.sections.learnings}</h2>
        {caseStudy.learnings.map((paragraph) => <p class={paragraphClasses}>{paragraph}</p>)}
      </section>
    </article>
  </div>
</div>

<div aria-hidden="true" class="fixed inset-x-0 top-0 z-30 h-[3px]">
  <div data-reading-progress class="h-full w-full origin-left scale-x-0 bg-sig"></div>
</div>

<script>
  import { setupReadingProgress } from '@/scripts/reading';

  const article = document.querySelector<HTMLElement>('[data-case-study]');
  const progress = document.querySelector<HTMLElement>('[data-reading-progress]');
  if (article && progress) setupReadingProgress(article, progress);
</script>
