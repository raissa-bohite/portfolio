---
import DomainCard from '@/components/molecules/DomainCard.astro';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const beyond = getDictionary(locale).aboutPage.beyond;
---

<section aria-labelledby="beyond-title" class="container-page flex flex-col gap-10 pb-24">
  <SectionHeading id="beyond-title" eyebrow={beyond.eyebrow} title={beyond.title} />
  <div data-scroll-group class="grid gap-6 md:grid-cols-3">
    {beyond.items.map((item) => <DomainCard icon={item.icon} title={item.title} text={item.text} />)}
  </div>
</section>
