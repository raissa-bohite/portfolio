---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Code from '@lucide/astro/icons/code-xml';
import Download from '@lucide/astro/icons/download';
import LayoutDashboard from '@lucide/astro/icons/layout-dashboard';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import { Image } from 'astro:assets';
import Button from '@/components/atoms/Button.astro';
import AvailabilityBadge from '@/components/molecules/AvailabilityBadge.astro';
import CodeConsole from '@/components/molecules/CodeConsole.astro';
import type { Locale } from '@/i18n/config';
import { getCvPath, getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';
import portrait from '@/assets/portrait/portrait-cutout.png';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const home = dictionary.home;
// Badges flottants autour du portrait : icône et position propres à chacun
const badgeIcons = [Code, LayoutDashboard, ShieldCheck];
// Sur mobile, les badges s'écartent du visage : en haut à gauche, puis sur la veste
const badgePositions = [
  'top-[8%] left-0 sm:top-[12%] sm:-left-10 [animation-delay:-1s]',
  'top-[64%] right-0 sm:top-[48%] sm:-right-12 [animation-delay:-2.5s]',
  'bottom-[5%] left-0 sm:bottom-[16%] sm:-left-8 [animation-delay:-4s]'
];
// Trait fin qui relie chaque badge à l'arche, terminé par un point (masqué sur mobile)
const badgeConnectors = [
  'top-full right-[22%] h-12 w-px origin-top -rotate-[38deg]',
  'top-full left-[24%] h-9 w-px origin-top rotate-[38deg]',
  'top-1/2 left-full h-px w-9'
];
const connectorDots = [
  'bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2',
  'bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2',
  'right-0 top-1/2 translate-x-1/2 -translate-y-1/2'
];
---

<section data-hero class="container-page pt-20 pb-12" aria-labelledby="hero-title">
  <div class="grid items-center gap-x-6 gap-y-12 lg:grid-cols-12">
    <div class="flex flex-col gap-6 lg:col-span-6">
      <AvailabilityBadge href={getRoutePath('contact', locale)} label={home.availability} />
      <CodeConsole variable={home.codeConsole.variable} value={home.codeConsole.value} />
      <h1 id="hero-title" class="m-0 text-display font-bold text-ink">
        {
          home.titleWords.map((word, index) => (
            <>
              <span class="inline-block overflow-hidden pb-[0.06em] align-bottom">
                <span data-word class="inline-block">{word}</span>
              </span>
              {index < home.titleWords.length - 1 && ' '}
            </>
          ))
        }<span data-title-cursor aria-hidden="true" class="animate-blink font-mono font-semibold text-sig">_</span>
      </h1>
      <!-- Pas d'animation sur ce paragraphe : c'est le plus grand élément visible au chargement (LCP) -->
      <p class="m-0 max-w-[40ch] text-lead">{home.intro}</p>
      <!-- Sur mobile, chaque bouton occupe toute la largeur : côte à côte, les libellés passaient sur deux lignes -->
      <div data-reveal class="mt-2 grid gap-3 sm:flex sm:flex-wrap">
        <Button href={getRoutePath('projects', locale)} shape="pill" class="cta-pair group">
          {home.ctaProjects}
          <ArrowRight aria-hidden="true" size={18} class="transition-transform duration-200 group-hover:translate-x-0.5" />
        </Button>
        <Button href={getCvPath(locale)} variant="secondary" shape="pill" download class="cta-pair">
          <Download aria-hidden="true" size={18} />
          {dictionary.common.cv}
        </Button>
      </div>
    </div>
    <!-- Portrait détouré sur une arche violette, entouré de badges : la personne d'abord, les projets juste en dessous -->
    <div class="lg:col-span-6">
      <div class="relative mx-auto aspect-square w-full max-w-[540px]">
        <!-- Décor : orbite orange autour de l'arche, grille de points, anneau et pastilles -->
        <div aria-hidden="true" class="hero-orbit hidden sm:block"></div>
        <div aria-hidden="true" class="absolute top-[3%] -right-[4%] hidden size-16 bg-[radial-gradient(circle,#b9a4f5_1.6px,transparent_1.8px)] bg-size-[22px_22px] sm:block"></div>
        <div aria-hidden="true" class="absolute right-[7%] bottom-0 left-[7%] h-[78%] rounded-t-full bg-linear-to-b from-[#6d3fd6] to-[#4a23a0]"></div>
        <div aria-hidden="true" class="absolute top-[6%] right-[14%] size-16 rounded-full border-[3px] border-sig"></div>
        <div aria-hidden="true" class="absolute top-[34%] left-[4%] size-3 rounded-full bg-sig"></div>
        <div aria-hidden="true" class="absolute top-[70%] -right-[3%] hidden size-3.5 rounded-full bg-action sm:block"></div>
        <Image
          src={portrait}
          alt={dictionary.meta.portraitAlt}
          widths={[520, 800, 1040]}
          sizes="(min-width: 1024px) 490px, 90vw"
          loading="eager"
          fetchpriority="high"
          class="absolute bottom-0 left-[3%] w-[94%]"
        />
        <ul class="m-0 list-none p-0">
          {
            home.heroBadges.map((badge, index) => {
              const Icon = badgeIcons[index] ?? Code;
              return (
                <li
                  data-reveal
                  class={`hero-badge absolute inline-flex items-center gap-2 rounded-full border border-glass-border bg-bg py-1.5 pr-3 pl-1.5 text-xs font-semibold sm:gap-2.5 sm:py-2 sm:pr-4 sm:pl-2 sm:text-sm text-ink shadow-glass-sm ${badgePositions[index] ?? ''}`}
                >
                  <span class="flex size-7 items-center justify-center rounded-full bg-tint text-tint-ink sm:size-8">
                    <Icon aria-hidden="true" size={16} />
                  </span>
                  {badge}
                  <span aria-hidden="true" class={`absolute hidden bg-tint-ink/25 sm:block ${badgeConnectors[index] ?? ''}`}>
                    <span class={`absolute size-2.5 rounded-full bg-[#b9a4f5] ring-4 ring-bg ${connectorDots[index] ?? ''}`}></span>
                  </span>
                </li>
              );
            })
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /*
    Orbite orange : un cercle centré sur celui de l'arche (centre à 65 % de hauteur, rayon 43 % de largeur),
    dont on ne garde que deux arcs grâce à un masque conique : en haut à droite et en bas à gauche, extrémités fondues.
  */
  .hero-orbit {
    position: absolute;
    top: 65%;
    left: 50%;
    width: 106%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border: 2px solid color-mix(in srgb, var(--sig) 85%, transparent);
    border-radius: 9999px;
    mask-image: conic-gradient(
      from 0deg,
      transparent 0deg 36deg,
      #000 50deg 86deg,
      transparent 102deg 222deg,
      #000 234deg 256deg,
      transparent 270deg 360deg
    );
  }

  /* Les badges flottent doucement, sauf si l'utilisateur a demandé moins de mouvement */
  @media (prefers-reduced-motion: no-preference) {
    .hero-badge {
      animation: hero-float 6s ease-in-out infinite;
    }
  }

  @keyframes hero-float {
    50% {
      translate: 0 -10px;
    }
  }
</style>

<script>
  import { playCodeConsole } from '@/scripts/code-console';
  import { playIntro } from '@/scripts/intro';
  import { whenPageReady } from '@/scripts/page-transition';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const codeConsole = hero?.querySelector<HTMLElement>('[data-code-console]');
  // À la première visite, l'entrée du haut de page démarre quand le chargeur se lève
  if (hero)
    void whenPageReady().then(() => {
      // Le grand titre arrive comme la sortie de console.log, une fois les deux lignes tapées
      const consoleEnd = codeConsole ? playCodeConsole(codeConsole) : 0;
      playIntro(hero, consoleEnd > 0 ? consoleEnd + 0.15 : 0.25);
    });
</script>
