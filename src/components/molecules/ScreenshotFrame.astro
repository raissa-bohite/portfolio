---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
  image: ImageMetadata;
  alt: string;
  caption: string;
};

const { image, alt, caption } = Astro.props;
---

<!-- Capture d'écran d'ordinateur : même carte vitrée que les galeries de projets, avec une légende -->
<figure data-scroll-item class="m-0 flex flex-col gap-3">
  <div class="glass overflow-hidden p-3">
    <Image
      src={image}
      alt={alt}
      widths={[640, 1200]}
      sizes="(min-width: 1024px) 432px, (min-width: 640px) 46vw, 94vw"
      loading="lazy"
      class="block h-auto w-full rounded-control bg-white"
    />
  </div>
  <figcaption class="text-sm font-semibold text-muted">{caption}</figcaption>
</figure>
