---

type Props = {
  href: string;
  label: string;
};

const { href, label } = Astro.props;
---

<!-- Simple ligne de texte précédée du point orange : lien discret vers la page Contact -->
<a
  href={href}
  data-reveal
  class="inline-flex min-h-11 items-center gap-2.5 self-start text-sm font-semibold text-ink no-underline hover:text-action"
>
  <span aria-hidden="true" class="size-2 rounded-full bg-sig"></span>
  {label}
</a>
