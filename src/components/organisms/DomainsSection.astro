---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Award from '@lucide/astro/icons/award';
import Monitor from '@lucide/astro/icons/monitor';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Sparkles from '@lucide/astro/icons/sparkles';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import type { Locale } from '@/i18n/config';
import { getDictionary } from '@/i18n/translate';
import { resolveDomainProofs } from '@/lib/domain-proofs';
import type { ProjectSummary } from '@/lib/projects';

type Props = { locale: Locale; projects: ProjectSummary[] };

const { locale, projects } = Astro.props;
const dictionary = getDictionary(locale);
const domains = dictionary.home.domains;
const skillsLabel = dictionary.projectPage.stack;
const proofLabels = { certification: domains.proofCertification, contactForm: domains.proofContactForm };
const domainIcons = { dashboard: Monitor, security: ShieldCheck, ai: Sparkles } as const;
const linkClasses =
  'inline-flex min-h-10 items-center gap-2 rounded-full border border-white/20 bg-white/[0.08] px-4 text-small font-semibold text-white no-underline transition-colors hover:border-white/40 hover:bg-white/[0.14] hover:text-white focus-visible:outline-white';
---

<!-- Seule section sombre de l'accueil : une pause visuelle entre les projets et la démarche. « overflow-clip » rogne le décor sans casser la colonne collante -->
<section aria-labelledby="domains-title" class="relative overflow-clip bg-linear-to-br from-[#2a1466] via-[#1e0f45] to-[#170b38] text-white">
  <span aria-hidden="true" class="absolute -top-40 -right-36 size-[420px] rounded-full bg-brand/35"></span>
  <span aria-hidden="true" class="absolute -bottom-44 -left-32 hidden size-[360px] rounded-full border-2 md:block border-[#f5a25d]/45 border-r-transparent border-b-transparent"></span>
  <span aria-hidden="true" class="absolute right-16 bottom-14 hidden h-16 w-20 bg-[radial-gradient(circle,rgb(196_178_255/0.55)_2px,transparent_2.5px)] bg-size-[21px_21px] md:block"></span>

  <div class="container-page relative grid gap-12 py-24 lg:grid-cols-[minmax(0,22rem)_minmax(0,1fr)] lg:gap-16">
    <div class="flex flex-col gap-4 lg:sticky lg:top-28 lg:self-start">
      <SectionIntro id="domains-title" eyebrow={domains.eyebrow} title={domains.title} intro={domains.closing.text} highlight={false} onDark cursor="bar" />
      <span aria-hidden="true" class="flex gap-2.5 pt-3">
        <span class="size-2.5 rounded-full bg-sig"></span>
        <span class="size-2.5 rounded-full bg-[#8b63ea]"></span>
        <span class="size-2.5 rounded-full bg-[#c4b2ff]"></span>
      </span>
    </div>

    <ol data-scroll-group class="m-0 flex list-none flex-col border-t border-white/15 p-0">
      {
        domains.items.map((domain, index) => {
          const Icon = domainIcons[domain.icon as keyof typeof domainIcons] ?? Monitor;
          const isAi = domain.icon === 'ai';
          const proofs = resolveDomainProofs(domain.icon, projects, proofLabels, '#contact');
          return (
            <li data-scroll-item class="flex flex-col gap-5 border-b border-white/15 py-9 sm:flex-row sm:gap-7">
              <span
                data-scroll-pop
                aria-hidden="true"
                class:list={[
                  'w-24 flex-none text-[4rem] leading-none font-extrabold tracking-[-0.04em] text-transparent',
                  isAi ? '[-webkit-text-stroke:1.5px_#f5a25d]' : '[-webkit-text-stroke:1.5px_#c4b2ff]'
                ]}
              >
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="flex min-w-0 flex-1 flex-col gap-3">
                <div class="flex items-center gap-3.5">
                  <span
                    aria-hidden="true"
                    class:list={[
                      'flex size-11 flex-none items-center justify-center rounded-xl',
                      isAi ? 'bg-linear-to-br from-[#f58a45] to-[#e0590c]' : 'bg-linear-to-br from-[#7b4fe0] to-brand-deep'
                    ]}
                  >
                    <Icon size={22} />
                  </span>
                  <h3 class="m-0 text-title font-extrabold text-white sm:text-[1.75rem]">{domain.title}</h3>
                </div>
                <p class="m-0 text-body-lg text-white/85">{domain.text}</p>
                <p class="m-0 font-mono text-[13px] text-white/70">
                  <span class="sr-only">{skillsLabel} : </span>
                  {domain.skills.join(' · ')}
                </p>
                {proofs.length > 0 && (
                  <div class="flex flex-wrap items-center gap-2.5 pt-1.5">
                    <span class="text-sm font-bold text-[#ffd9c2]">{domains.proofLabel}</span>
                    <ul class="m-0 flex list-none flex-wrap gap-2.5 p-0">
                      {proofs.map((proof) => (
                        <li>
                          {proof.href ? (
                            <a href={proof.href} class={linkClasses}>
                              {proof.label}
                              <ArrowRight aria-hidden="true" size={15} />
                            </a>
                          ) : (
                            <span
                              class:list={[
                                'inline-flex min-h-10 items-center gap-2 rounded-full border px-4 text-small font-semibold',
                                proof.highlighted ? 'border-sig/40 bg-sig/15 text-[#ffd9c2]' : 'border-white/20 bg-white/[0.08] text-white'
                              ]}
                            >
                              {proof.highlighted && <Award aria-hidden="true" size={15} />}
                              {proof.label}
                            </span>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
