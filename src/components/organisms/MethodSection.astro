---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import CircleCheck from '@lucide/astro/icons/circle-check';
import Code from '@lucide/astro/icons/code-xml';
import Lightbulb from '@lucide/astro/icons/lightbulb';
import PenTool from '@lucide/astro/icons/pen-tool';
import Search from '@lucide/astro/icons/search';
import Shield from '@lucide/astro/icons/shield';
import ShieldCheck from '@lucide/astro/icons/shield-check';
import Target from '@lucide/astro/icons/target';
import User from '@lucide/astro/icons/user';
import ClosingBand from '@/components/molecules/ClosingBand.astro';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import type { Locale } from '@/i18n/config';
import { formatMessage, getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const method = getDictionary(locale).home.method;
// Une pastille par étape : violet foncé, lavande, violet foncé, orange pour la dernière
const badgeClasses = ['bg-brand-deeper text-white', 'bg-brand text-white', 'bg-brand-deeper text-white', 'bg-sig text-[#1e0f45]'];
const flowIcons = [Search, PenTool, Code, ShieldCheck];
---

<section aria-labelledby="method-title" class="relative overflow-hidden bg-tint/45 dark:bg-white/[0.03]">
  <span aria-hidden="true" class="absolute -top-36 -right-28 size-72 rounded-full bg-tint dark:bg-tint/60"></span>
  <span aria-hidden="true" class="absolute top-16 right-[26%] hidden size-4 rounded-full bg-sig md:block"></span>
  <span aria-hidden="true" class="absolute top-40 right-10 hidden h-14 w-20 bg-[radial-gradient(circle,#b9a4f5_2px,transparent_2.5px)] bg-size-[19px_19px] md:block"></span>

  <div class="container-page relative flex flex-col gap-11 py-20">
    <SectionIntro id="method-title" eyebrow={method.eyebrow} title={method.title} highlight={false} cursor="bar" />

    <ol data-scroll-group aria-label={method.listLabel} class="m-0 grid list-none gap-6 p-0 sm:grid-cols-2 lg:grid-cols-4">
      {
        method.steps.map((step, index) => (
          <li data-scroll-item class="relative flex flex-col gap-3.5 rounded-surface border border-glass-border bg-glass-strong p-6 shadow-glass">
            <!-- Illustration de l'étape, décorative -->
            <div aria-hidden="true" class="relative h-[170px]">
              {index === 0 && (
                <>
                  <span class="absolute inset-[10px_20px_0_10px] rounded-full bg-tint/70 dark:bg-tint" />
                  <span class="absolute top-6 left-6 h-[120px] w-[190px] overflow-hidden rounded-xl bg-white shadow-[0_10px_24px_rgb(30_15_69/0.12)]">
                    <span class="block h-5 bg-[#e6ddfb]" />
                    <span class="flex flex-col gap-2 pt-4 pr-4 pl-[70px]">
                      <span class="h-1.5 rounded-full bg-[#d9cef9]" />
                      <span class="h-1.5 w-[70%] rounded-full bg-[#d9cef9]" />
                    </span>
                  </span>
                  <span class="absolute top-[74px] left-2 flex size-[54px] items-center justify-center rounded-[14px] bg-white text-brand shadow-[0_8px_20px_rgb(30_15_69/0.14)]">
                    <Target size={28} />
                  </span>
                  <span class="absolute top-[52px] left-24 flex size-[30px] items-center justify-center rounded-full bg-[#fde3d2] text-brand">
                    <User size={16} />
                  </span>
                  <span class="absolute top-[100px] left-24 flex size-[30px] items-center justify-center rounded-full bg-tint text-brand">
                    <User size={16} />
                  </span>
                </>
              )}
              {index === 1 && (
                <>
                  <span class="absolute inset-[10px_10px_0_20px] rounded-full bg-tint/70 dark:bg-tint" />
                  <span class="absolute top-[22px] left-[30px] h-[126px] w-[200px] -rotate-[8deg] overflow-hidden rounded-xl bg-white shadow-[0_12px_26px_rgb(30_15_69/0.14)]">
                    <span class="block h-4 bg-brand" />
                    <span class="flex gap-2.5 p-3">
                      <span class="flex flex-1 flex-col gap-[7px]">
                        <span class="h-1.5 rounded-full bg-[#d9cef9]" />
                        <span class="h-1.5 rounded-full bg-[#d9cef9]" />
                        <span class="h-1.5 w-[60%] rounded-full bg-[#d9cef9]" />
                      </span>
                      <span class="h-[60px] w-[70px] rounded-md border-2 border-[#d9cef9]" />
                    </span>
                  </span>
                  <span class="absolute bottom-1.5 left-3 h-9 w-[46px] -rotate-[10deg] rounded-lg bg-[#f5a25d]" />
                  <span class="absolute top-[30px] right-2 flex size-[54px] items-center justify-center rounded-[14px] bg-white text-brand shadow-[0_8px_20px_rgb(30_15_69/0.14)]">
                    <PenTool size={28} />
                  </span>
                </>
              )}
              {index === 2 && (
                <>
                  <span class="absolute top-3.5 left-3.5 flex h-[136px] w-[200px] flex-col gap-2 rounded-xl bg-[#1b1530] p-3 shadow-[0_14px_30px_rgb(30_15_69/0.28)]">
                    <span class="flex gap-1">
                      <span class="size-1.5 rounded-full bg-sig" />
                      <span class="size-1.5 rounded-full bg-[#f5a25d]" />
                      <span class="size-1.5 rounded-full bg-[#6ccf8e]" />
                    </span>
                    <span class="h-[5px] w-[64%] rounded-full bg-[#8b63ea]" />
                    <span class="ml-3.5 h-[5px] w-[48%] rounded-full bg-[#6ccf8e]" />
                    <span class="ml-3.5 h-[5px] w-[70%] rounded-full bg-lilac" />
                    <span class="ml-7 h-[5px] w-[40%] rounded-full bg-[#f5a25d]" />
                    <span class="h-[5px] w-[56%] rounded-full bg-[#8b63ea]" />
                    <span class="h-[5px] w-[30%] rounded-full bg-[#4c4570]" />
                  </span>
                  <span class="absolute top-3.5 right-1.5 flex size-[50px] items-center justify-center rounded-[14px] bg-[#e6ddfb] text-brand">
                    <Code size={26} />
                  </span>
                  <span class="absolute top-[84px] right-5 flex size-[50px] items-center justify-center rounded-[14px] bg-white text-brand shadow-[0_8px_20px_rgb(30_15_69/0.14)]">
                    <Shield size={24} />
                  </span>
                </>
              )}
              {index === 3 && (
                <>
                  <span class="absolute inset-[10px_10px_0_10px] rounded-full bg-tint/70 dark:bg-tint" />
                  <span class="absolute top-[34px] left-[18px] flex h-[116px] w-[92px] flex-col gap-3 rounded-xl bg-white p-3 shadow-[0_10px_24px_rgb(30_15_69/0.12)]">
                    {[0, 1, 2].map(() => (
                      <span class="flex items-center gap-1.5 text-brand">
                        <CircleCheck size={14} />
                        <span class="h-[5px] flex-1 rounded-full bg-[#d9cef9]" />
                      </span>
                    ))}
                  </span>
                  <span class="absolute top-[70px] left-[118px] flex h-14 w-[50px] items-center justify-center rounded-[12px_12px_22px_22px] bg-brand text-white">
                    <ShieldCheck size={26} />
                  </span>
                  <span class="absolute top-[26px] right-[18px] h-28 w-[58px] rounded-[14px] border-[3px] border-brand-deeper bg-white" />
                  <span class="absolute top-[108px] left-40 flex size-[30px] items-center justify-center rounded-full bg-[#1f9d55] text-white">
                    <CircleCheck size={18} />
                  </span>
                </>
              )}
            </div>

            <span aria-hidden="true" class:list={['flex size-[52px] items-center justify-center rounded-full text-lg font-bold', badgeClasses[index]]}>
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="m-0 font-mono text-[1.5rem] font-semibold text-ink" lang="fr">
              <span class="sr-only">{formatMessage(method.step, { n: index + 1 })} : </span>{step.code}
            </h3>
            <p class="m-0 text-base text-text">{step.text}</p>
            <p class="m-0 mt-auto flex flex-col gap-1.5 rounded-[14px] bg-tint/45 px-4 py-3.5 text-sm dark:bg-tint">
              <span class="flex items-center gap-2 font-bold text-action">
                <CircleCheck aria-hidden="true" size={16} />
                {method.deliverableLabel}
              </span>
              <span class="text-ink">{step.deliverable}</span>
            </p>

            {index < method.steps.length - 1 && (
              <span aria-hidden="true" class="absolute top-1/2 -right-[19px] z-10 hidden text-action lg:block">
                <ArrowRight size={16} />
              </span>
            )}
          </li>
        ))
      }
    </ol>

    <ClosingBand title={method.closing.title} text={method.closing.text}>
      <Lightbulb slot="icon" size={32} />
      <ol slot="aside" aria-hidden="true" class="m-0 hidden list-none items-start gap-2 p-0 text-center xl:mr-24 xl:flex">
        {
          method.steps.map((step, index) => (
            <>
              <li class="flex w-[5.5rem] flex-col items-center gap-2">
                <span class:list={['flex size-14 items-center justify-center rounded-full text-action', index === 3 ? 'bg-[#fde8dc]' : 'bg-white dark:bg-white/10']}>
                  {(() => {
                    const FlowIcon = flowIcons[index] ?? Code;
                    return <FlowIcon size={24} />;
                  })()}
                </span>
                <span class="font-mono text-[13px] font-semibold text-ink">{step.code}</span>
              </li>
              {index < method.steps.length - 1 && (
                <li class="pt-4 text-action">
                  <ArrowRight size={16} />
                </li>
              )}
            </>
          ))
        }
      </ol>
    </ClosingBand>
  </div>
</section>
