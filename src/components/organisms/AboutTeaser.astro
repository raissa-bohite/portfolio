---
import ArrowRight from '@lucide/astro/icons/arrow-right';
import SectionHeading from '@/components/molecules/SectionHeading.astro';
import type { Locale } from '@/i18n/config';
import { getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const about = dictionary.home.about;
---

<!-- Parcours en frise horizontale : le portrait est déjà en haut de page, la section raconte le chemin -->
<section aria-labelledby="about-title" class="container-page flex flex-col gap-12 py-24">
  <div data-scroll-group class="grid gap-6 lg:grid-cols-12 lg:items-end">
    <div data-scroll-item class="lg:col-span-7">
      <SectionHeading id="about-title" eyebrow={about.eyebrow} title={about.title} />
    </div>
    <div data-scroll-item class="flex flex-col gap-4 lg:col-span-5">
      <p class="m-0 text-lg">{about.text}</p>
      <a
        href={getRoutePath('about', locale)}
        class="group inline-flex min-h-12 items-center gap-2 self-start text-base font-semibold underline decoration-[1.5px] underline-offset-[5px]"
      >
        {about.link}
        <ArrowRight aria-hidden="true" size={18} class="transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  </div>

  <ol data-scroll-group class="relative m-0 grid list-none gap-5 p-0 md:grid-cols-3">
    <!-- Ligne de la frise, derrière les pastilles -->
    <span aria-hidden="true" class="absolute top-[11px] right-[16%] left-[16%] hidden h-0.5 rounded-full bg-line md:block"></span>
    {
      about.timeline.map((milestone) => (
        <li data-scroll-item class="relative flex flex-col items-start gap-5 md:items-center">
          <span
            data-scroll-pop
            aria-hidden="true"
            class:list={[
              'relative z-10 hidden size-6 rounded-full border-[3px] md:block',
              milestone.current ? 'border-sig bg-sig shadow-[0_0_0_7px_rgb(242_106_27/0.18)]' : 'border-action bg-bg'
            ]}
          />
          <div
            class:list={[
              'flex w-full flex-1 flex-col gap-2 rounded-surface border p-6 shadow-glass',
              milestone.current ? 'border-sig bg-bg' : 'border-glass-border bg-glass-strong'
            ]}
          >
            <span class:list={['font-mono text-sm font-semibold', milestone.current ? 'text-sig-text' : 'text-action']}>{milestone.period}</span>
            <span class="text-base leading-snug font-semibold text-ink">{milestone.text}</span>
          </div>
        </li>
      ))
    }
  </ol>
</section>
