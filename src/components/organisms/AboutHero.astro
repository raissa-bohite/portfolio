---
import { Image } from 'astro:assets';
import ArrowRight from '@lucide/astro/icons/arrow-right';
import Download from '@lucide/astro/icons/download';
import MapPin from '@lucide/astro/icons/map-pin';
import portrait from '@/assets/portrait/portrait-about.png';
import Button from '@/components/atoms/Button.astro';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import type { Locale } from '@/i18n/config';
import { getCvPath, getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';

type Props = { locale: Locale };

const { locale } = Astro.props;
const dictionary = getDictionary(locale);
const page = dictionary.aboutPage;
const languageCodes = page.languages.items.map((language) => language.code);
---

<section aria-labelledby="about-page-title" class="container-page overflow-x-clip pt-14 pb-18">
  <div class="grid items-center gap-x-10 gap-y-12 lg:grid-cols-12">
    <div class="flex flex-col items-start gap-7 lg:col-span-6">
      <SectionIntro id="about-page-title" eyebrow={page.eyebrow} title={page.title} intro={page.intro} highlight={false} cursor level="page" />
      <!-- Sur mobile, chaque bouton occupe toute la largeur : côte à côte, les libellés passaient sur deux lignes -->
      <div class="grid w-full gap-3 sm:flex sm:w-auto sm:flex-wrap">
        <Button href={getCvPath(locale)} download shape="pill" class="cta-pair">
          <Download aria-hidden="true" size={18} />
          {dictionary.common.cv}
        </Button>
        <Button href={getRoutePath('contact', locale)} variant="secondary" shape="pill" class="cta-pair">
          {page.contactCta}
          <ArrowRight aria-hidden="true" size={18} />
        </Button>
      </div>
    </div>

    <!-- Portrait sur une arche violette aux coins bas arrondis, lieu et langues en badges flottants -->
    <div class="lg:col-span-6">
      <div class="relative isolate mx-auto aspect-[46/54] w-full max-w-[560px]">
        <!-- Halo lavande derrière l'arche et grille de points : détachent la photo du fond -->
        <div aria-hidden="true" class="absolute -inset-x-[12%] top-[8%] -bottom-[6%] -z-10 rounded-full bg-[radial-gradient(closest-side,rgb(185_164_245/0.75),transparent)] dark:bg-[radial-gradient(closest-side,rgb(109_63_214/0.45),transparent)]"></div>
        <div aria-hidden="true" class="absolute -right-[8%] bottom-[6%] hidden size-24 bg-[radial-gradient(circle,#b9a4f5_2px,transparent_2.5px)] bg-size-[16px_16px] sm:block"></div>
        <div aria-hidden="true" class="absolute right-[6%] bottom-0 left-[6%] h-[74%] rounded-t-full rounded-b-[32px] bg-linear-to-br from-[#7b4fe0] to-brand-deep shadow-[0_40px_80px_-20px_rgb(74_35_160/0.55)]"></div>
        <div aria-hidden="true" class="absolute top-[6%] left-[-1%] aspect-square w-[102%] -rotate-[15deg] rounded-full border-2 border-[#f5a25d] border-b-transparent border-l-transparent"></div>
        <!-- Photo rognée à la largeur de l'arche, coins bas arrondis ; la tête dépasse par le haut -->
        <div class="absolute inset-y-0 right-[6%] left-[6%] overflow-hidden rounded-b-[32px]">
          <Image
            src={portrait}
            alt={dictionary.meta.portraitAlt}
            widths={[560, 960, 1254]}
            sizes="(min-width: 1024px) 640px, 110vw"
            loading="eager"
            fetchpriority="high"
            class="absolute bottom-0 left-1/2 w-[128%] max-w-none -translate-x-[48%] drop-shadow-[0_18px_24px_rgb(30_15_69/0.35)]"
          />
        </div>
        <p class="absolute bottom-[18%] left-0 m-0 inline-flex items-center gap-3 rounded-full border border-glass-border bg-bg py-2 pr-5 pl-2 text-base font-bold text-ink shadow-glass sm:-left-6">
          <span aria-hidden="true" class="flex size-10 items-center justify-center rounded-full bg-sig text-white">
            <MapPin size={18} />
          </span>
          {page.location}
        </p>
        <p aria-label={page.languages.title} class="absolute top-[22%] right-0 m-0 flex gap-1.5 rounded-full border border-glass-border bg-bg p-2.5 font-mono text-sm font-semibold uppercase shadow-glass sm:-right-4">
          {
            languageCodes.map((code, index) => (
              <span lang={code} class:list={['rounded-full px-2.5 py-1', index === 0 ? 'bg-action text-action-ink' : 'bg-tint text-tint-ink']}>{code}</span>
            ))
          }
        </p>
      </div>
    </div>
  </div>
</section>
