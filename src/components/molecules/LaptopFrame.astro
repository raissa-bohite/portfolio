---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// parallax : amplitude en pixels de l'effet de profondeur au défilement (voir parallax.ts)
type Props = { image: ImageMetadata; sizes: string; class?: string; priority?: boolean; parallax?: number };
const { image, sizes, class: className, priority = false, parallax } = Astro.props;
---

<!-- Ordinateur portable décoratif : écran à bord sombre, caméra, socle argenté plus large que l'écran -->
<div aria-hidden="true" data-parallax={parallax} class:list={['drop-shadow-[0_30px_40px_rgb(30_15_69/0.3)]', className]}>
  <div class="relative rounded-t-[16px] bg-[#17122b] p-[2.6%] pb-[3.4%]">
    <span class="absolute top-[1%] left-1/2 size-1 -translate-x-1/2 rounded-full bg-[#3a3352]"></span>
    <Image
      src={image}
      alt=""
      widths={[480, 900, 1400]}
      sizes={sizes}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : 'auto'}
      class="block aspect-[16/10] h-auto w-full rounded-[4px] object-cover object-top"
    />
  </div>
  <div class="relative -mx-[8%] h-3.5 rounded-b-[14px] bg-linear-to-b from-[#e4e2ea] to-[#a9a6b6] sm:h-4">
    <span class="absolute top-0 left-1/2 h-1.5 w-[14%] -translate-x-1/2 rounded-b-md bg-[#c5c2cf]"></span>
  </div>
</div>
