---
import ProjectVisual from '@/components/molecules/ProjectVisual.astro';
import type { ProjectSummary } from '@/lib/projects';

type Props = { label: string; project: ProjectSummary };
const { label, project } = Astro.props;
---

<!-- Couverture de l'étude de cas : la même vignette aux couleurs du projet que dans la galerie, en grand format -->
<section aria-label={label} class="container-page pb-24">
  <ProjectVisual project={project} label={project.coverAlt} aspectClass="aspect-[4/3] md:aspect-[21/9]" priority />
</section>
