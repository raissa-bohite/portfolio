---
import ArrowUpRight from '@lucide/astro/icons/arrow-up-right';
import Button from '@/components/atoms/Button.astro';
import Breadcrumb from '@/components/molecules/Breadcrumb.astro';
import SectionIntro from '@/components/molecules/SectionIntro.astro';
import type { Locale } from '@/i18n/config';
import { getRoutePath } from '@/i18n/routes';
import { getDictionary } from '@/i18n/translate';

type Props = {
  locale: Locale;
  name: string;
  eyebrow: string;
  title: string;
  lead: string;
  liveUrl: string | undefined;
};

const { locale, name, eyebrow, title, lead, liveUrl } = Astro.props;
const dictionary = getDictionary(locale);
---

<!-- Même en-tête que la page Projets : sur-titre à trait, titre à curseur, décor de cercles à droite -->
<section aria-labelledby="project-title" class="relative overflow-hidden">
  <span aria-hidden="true" class="absolute top-2 -right-16 hidden size-64 rounded-full bg-tint/80 md:block dark:bg-tint/50"></span>
  <span aria-hidden="true" class="absolute top-16 right-64 hidden size-4 rounded-full bg-sig md:block"></span>
  <div class="container-page relative flex flex-col items-start gap-7 pt-14 pb-12">
    <Breadcrumb
      label={dictionary.projectPage.breadcrumb}
      parent={{ href: getRoutePath('projects', locale), label: dictionary.nav.projects }}
      current={name}
    />
    <SectionIntro id="project-title" eyebrow={eyebrow} title={title} intro={lead} highlight={false} cursor level="page" class="max-w-[52rem]" />
    {
      liveUrl && (
        <Button href={liveUrl} rel="noopener" target="_blank" shape="pill">
          {dictionary.projectPage.visit}
          <ArrowUpRight aria-hidden="true" size={18} />
        </Button>
      )
    }
  </div>
</section>
